# GEMINI_API_KEY: Required for Gemini AI API calls.
# No AI Studio isso é injetado automaticamente pelo painel de Secrets. No deploy
# self-hosted (Docker/jrnex), preencha manualmente se algum recurso de IA usar.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: usado pelo AI Studio (Cloud Run). Não é usado no deploy self-hosted.
APP_URL="MY_APP_URL"

# ---------------------------------------------------------------------------
# Variáveis do deploy self-hosted (Docker Compose no jrnex) — copie este
# arquivo para ".env" ao lado do docker-compose.yml e preencha valores reais.
# Gere segredos fortes com: openssl rand -base64 32
# ---------------------------------------------------------------------------

POSTGRES_DB="nex_erp"
POSTGRES_USER="nex_user"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"

JWT_SECRET="troque-por-um-segredo-aleatorio-longo"
FRONTEND_URL="http://localhost"

# Credenciais do ConectaGov (integração fiscal). Opcionais — sem elas, o
# /health do backend só reporta "não configurado".
CONECTAGOV_CLIENT_ID=""
CONECTAGOV_CLIENT_SECRET=""
CONECTAGOV_CPF_USUARIO=""
CONECTAGOV_PRIVATE_KEY=""

# Só precisam ser definidos ao rodar mais de um ambiente na mesma máquina (ex: dev
# ao lado de prod). Em produção, deixe sem definir — os defaults abaixo mantêm o
# comportamento atual.
# CONTAINER_PREFIX="nexdev"
# HTTP_PORT=8080
