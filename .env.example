# NEX Gestor Financeiro Environment Variables
#
# Copie este arquivo para ".env" (no servidor, ao lado do docker-compose.yml)
# e preencha com valores reais e únicos. NUNCA faça commit do ".env".
# Gere segredos fortes com: openssl rand -base64 32

# Usados pelo container do Postgres e montados na DATABASE_URL do app (ver docker-compose.yml)
POSTGRES_DB="nex_erp"
POSTGRES_USER="nex_user"
POSTGRES_PASSWORD="troque-por-uma-senha-forte"

# Usado quando roda fora do Docker (npm run dev/start) — deve espelhar os valores acima
DATABASE_URL="postgresql://nex_user:troque-por-uma-senha-forte@localhost:5432/nex_erp?schema=public"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="troque-por-um-segredo-aleatorio-longo"
GEMINI_API_KEY=""
FRONTEND_URL="http://localhost:3000"
PORT=3000
NODE_ENV="development"
