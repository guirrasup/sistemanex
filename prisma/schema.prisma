// Prisma Schema for NEXS Gestor Financeiro Enterprise
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Company {
  id        String   @id @default(uuid())
  legalName String   @map("legal_name")
  tradeName String?  @map("trade_name")
  taxId     String   @unique @map("tax_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  users              User[]
  people             Person[]
  bankAccounts       BankAccount[]
  financialDocuments FinancialDocument[]
  products           Product[]
  auditLogs          AuditLog[]

  @@map("companies")
}

model User {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("operator")
  mfaEnabled   Boolean  @default(false) @map("mfa_enabled")
  mfaSecret    String?  @map("mfa_secret")
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  auditLogs AuditLog[]

  @@map("users")
}

model Person {
  id                String   @id @default(uuid())
  companyId         String   @map("company_id")
  legalName         String   @map("legal_name")
  tradeName         String?  @map("trade_name")
  taxId             String   @map("tax_id")
  personType        String   @map("person_type") // individual, company
  personRole        String   @map("person_role") // customer, supplier, both
  stateRegistration String?  @map("state_registration")
  isActive          Boolean  @default(true) @map("is_active")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  company            Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  financialDocuments FinancialDocument[]

  @@map("people")
}

model BankAccount {
  id             String   @id @default(uuid())
  companyId      String   @map("company_id")
  accountName    String   @map("account_name")
  bankCode       String   @map("bank_code")
  agency         String
  accountNumber  String   @map("account_number")
  accountType    String   @default("checking") @map("account_type")
  balance        Decimal  @default(0.00) @db.Decimal(15, 2)
  blockedBalance Decimal? @default(0.00) @map("blocked_balance") @db.Decimal(15, 2)
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  company     Company      @relation(fields: [companyId], references: [id], onDelete: Cascade)
  settlements Settlement[]

  @@map("bank_accounts")
}

model FinancialDocument {
  id              String   @id @default(uuid())
  companyId       String   @map("company_id")
  personId        String?  @map("person_id")
  documentType    String   @map("document_type") // payable, receivable
  title           String
  documentNumber  String?  @map("document_number")
  issueDate       DateTime @map("issue_date")
  dueDate         DateTime @map("due_date")
  totalAmount     Decimal  @map("total_amount") @db.Decimal(15, 2)
  netAmount       Decimal  @map("net_amount") @db.Decimal(15, 2)
  status          String   @default("draft")
  isFiscalLocked  Boolean  @default(false) @map("is_fiscal_locked")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Cascade)
  person       Person?       @relation(fields: [personId], references: [id])
  installments Installment[]

  @@map("financial_documents")
}

model Installment {
  id                String   @id @default(uuid())
  documentId        String   @map("document_id")
  installmentNumber Int      @map("installment_number")
  dueDate           DateTime @map("due_date")
  amount            Decimal  @db.Decimal(15, 2)
  paidAmount        Decimal  @default(0.00) @map("paid_amount") @db.Decimal(15, 2)
  status            String   @default("open")
  createdAt         DateTime @default(now()) @map("created_at")

  document    FinancialDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  settlements Settlement[]

  @@map("installments")
}

model Settlement {
  id                   String   @id @default(uuid())
  installmentId        String   @map("installment_id")
  bankAccountId        String   @map("bank_account_id")
  paymentDate          DateTime @map("payment_date")
  amount               Decimal  @db.Decimal(15, 2)
  interestAmount       Decimal? @default(0.00) @map("interest_amount") @db.Decimal(15, 2)
  fineAmount           Decimal? @default(0.00) @map("fine_amount") @db.Decimal(15, 2)
  discountAmount       Decimal? @default(0.00) @map("discount_amount") @db.Decimal(15, 2)
  netPaid              Decimal  @map("net_paid") @db.Decimal(15, 2)
  paymentMethod        String   @map("payment_method")
  reconciliationStatus String?  @default("unreconciled") @map("reconciliation_status")
  createdAt            DateTime @default(now()) @map("created_at")

  installment Installment @relation(fields: [installmentId], references: [id], onDelete: Cascade)
  bankAccount BankAccount @relation(fields: [bankAccountId], references: [id])

  @@map("settlements")
}

model Product {
  id           String   @id @default(uuid())
  companyId    String   @map("company_id")
  sku          String   @unique
  name         String
  category     String?
  unitPrice    Decimal  @map("unit_price") @db.Decimal(15, 2)
  costPrice    Decimal  @map("cost_price") @db.Decimal(15, 2)
  currentStock Decimal  @default(0) @map("current_stock") @db.Decimal(12, 3)
  minStock     Decimal? @default(5) @map("min_stock") @db.Decimal(12, 3)
  isActive     Boolean  @default(true) @map("is_active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@map("products")
}

model AuditLog {
  id         String   @id @default(uuid())
  companyId  String?  @map("company_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  payload    Json?
  ipAddress  String?  @map("ip_address")
  createdAt  DateTime @default(now()) @map("created_at")

  company Company? @relation(fields: [companyId], references: [id])
  user    User?    @relation(fields: [userId], references: [id])

  @@map("audit_logs")
}
