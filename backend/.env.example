# C:\emissornfe\backend\.env

# ============================================
# CONECTAGOV - EXEMPLO
# ============================================
CONECTAGOV_CLIENT_ID="EXEMPLO_CLIENT_ID_NAO_REAL"
CONECTAGOV_CLIENT_SECRET="EXEMPLO_CLIENT_SECRET_NAO_REAL"
CONECTAGOV_CPF_USUARIO="00000000000"

# Chave privada RSA - APENAS EXEMPLO
CONECTAGOV_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nEXEMPLO_CHAVE_PRIVADA_NAO_REAL\nAPENAS_PARA_DESENVOLVIMENTO\n-----END PRIVATE KEY-----"

# ============================================
# CRIPTOGRAFIA DE CERTIFICADO DIGITAL
# ============================================
# Valor fictício. NÃO utilizar em produção.
CERTIFICADO_ENCRYPTION_KEY="EXEMPLO_CHAVE_AES_256_NAO_REAL"

# ============================================
# DATABASE
# ============================================
DATABASE_URL="postgresql://usuario:senha@localhost:5432/banco_exemplo?schema=public"

# ============================================
# JWT
# ============================================
JWT_SECRET="EXEMPLO_JWT_SECRET_NAO_REAL"
JWT_EXPIRES_IN="7d"

# ============================================
# API
# ============================================
PORT=3333
NODE_ENV=development

# ============================================
# TRANSMISSÃO PARA SEFAZ
# ============================================
# true  = transmissão real
# false = modo mock/local
SEFAZ_TRANSMISSAO_REAL=true

# ============================================
# SEED
# ============================================
SEED_ADMIN_SENHA="EXEMPLO_SENHA_NAO_REAL"
SEED_AMBIENTE="HOMOLOGACAO"