  vFCP                  Decimal   @db.Decimal(15, 4) @default(0)
  vBCST                 Decimal   @db.Decimal(15, 4) @default(0) // Base de cálculo ICMS ST
  vST                   Decimal   @db.Decimal(15, 4) @default(0) // Valor ICMS ST
  vFCPST                Decimal   @db.Decimal(15, 4) @default(0)
  vFCPSTRet             Decimal   @db.Decimal(15, 4) @default(0)
  vProd                 Decimal   @db.Decimal(15, 4)          // Valor total dos produtos
  vFrete                Decimal   @db.Decimal(15, 4) @default(0) // Valor do frete
  vSeg                  Decimal   @db.Decimal(15, 4) @default(0) // Valor do seguro
  vDesc                 Decimal   @db.Decimal(15, 4) @default(0) // Valor do desconto
  vII                   Decimal   @db.Decimal(15, 4) @default(0) // Valor do II
  vIPI                  Decimal   @db.Decimal(15, 4) @default(0) // Valor do IPI
  vIPIDevol             Decimal   @db.Decimal(15, 4) @default(0) // Valor IPI devolução
  vPIS                  Decimal   @db.Decimal(15, 4) @default(0) // Valor do PIS
  vCOFINS               Decimal   @db.Decimal(15, 4) @default(0) // Valor do COFINS
  vOutro                Decimal   @db.Decimal(15, 4) @default(0) // Outras despesas
  vNF                   Decimal   @db.Decimal(15, 4)          // Valor total da NF-e
  vTotTrib              Decimal   @db.Decimal(15, 4) @default(0) // Total tributos aproximado

  // === ICMS UF DESTINO ===
  vFCPUFDest            Decimal   @db.Decimal(15, 4) @default(0)
  vICMSUFDest           Decimal   @db.Decimal(15, 4) @default(0)
  vICMSUFRemet          Decimal   @db.Decimal(15, 4) @default(0)

  // === ICMS MONOFÁSICO ===
  qBCMono               Decimal?  @db.Decimal(15, 4)
  vICMSMono             Decimal?  @db.Decimal(15, 4)
  qBCMonoReten          Decimal?  @db.Decimal(15, 4)
  vICMSMonoReten        Decimal?  @db.Decimal(15, 4)
  qBCMonoRet            Decimal?  @db.Decimal(15, 4)
  vICMSMonoRet          Decimal?  @db.Decimal(15, 4)

  // === IBS/CBS ===
  vIBS                  Decimal   @db.Decimal(15, 4) @default(0)
  vCBS                  Decimal   @db.Decimal(15, 4) @default(0)

  // === INFORMAÇÕES ADICIONAIS ===
  infAdFisco            String?   @db.VarChar(2000)
  infCpl                String?   @db.VarChar(5000)

  // === CONTROLE DE IMPRESSÃO DANFE (MANUAL - V.7) ===
  danfeImpresso         Boolean   @default(false)
  dataHoraImpressao     DateTime?
  usuarioImpressao      String?

  // === PROTOCOLOS ===
  protocoloAutorizacao  String?   @db.Char(17)
  dataHoraAutorizacao   DateTime?
  motivoCancelamento    String?
  dataHoraCancelamento  DateTime?
  motivoRejeicao        String?   @db.VarChar(500)
  dataHoraRejeicao      DateTime?

  // === XMLs ===
  xmlAssinado           String    @db.Text
  xmlRetorno            String?   @db.Text

  // === CONTROLE DE ENVIO ===
  enviadoEm             DateTime?
  enviadoPor            String?
  ipEnvio               String?   @db.VarChar(45)
  reciboLote            String?   @db.VarChar(15)

  // === RELACIONAMENTOS ===
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  destinatarioId        String
  destinatario          Cliente   @relation("NFeDestinatario", fields: [destinatarioId], references: [id])
  loteId                String?
  lote                  LoteNFe?  @relation("LoteNFe", fields: [loteId], references: [id])

  itens                 ItemNFe[]
  duplicatas            Duplicata[]
  transporte            TransporteNFe?
  pagamentos            PagamentoNFe[]
  referencias           NFeReferencia[]
  eventos               EventoNFe[]
  intermediador         Intermediador?
  exportacao            Exportacao?
  compra                Compra?
  cana                  Cana?
  responsavelTecnico    ResponsavelTecnico?
  processos             ProcessoReferenciado[]
  danfes                Danfe[]
  envios                EnvioNFe[]
  inutilizacao          InutilizacaoNFe?
  historicoStatus       HistoricoStatusNFe[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("nfes")
