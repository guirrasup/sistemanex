model ProcessoReferenciado {
  id                    String    @id @default(cuid())
  nfeId                 String
  nfe                   NFe       @relation(fields: [nfeId], references: [id])
  nProc                 String    @db.VarChar(60)
  indProc               IndProc   @default(SEFAZ)
  tpAto                 TpAto?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("processos_referenciados")
}
