// ============================================
// NF-e NO MDF-e
// ============================================

model MDFeNFe {
  id                    String    @id @default(cuid())
  munDescargaId         String
  munDescarga           MunDescargaMDFe @relation(fields: [munDescargaId], references: [id])
  chNFe                 String    @db.Char(44)
  SegCodBarra           String?   @db.VarChar(60)
  indReentrega          Boolean?  @default(false)
  
  // === UNIDADES DE TRANSPORTE ===
  unidadesTransporte    MDFeUnidadeTransp[]
  
  // === PRODUTOS PERIGOSOS ===
  perigosos             MDFePerigoso[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_nfes")
  @@index([munDescargaId])
  @@index([chNFe])
  @@unique([munDescargaId, chNFe])
}

// ============================================
// MDF-e NO MDF-e (Modal Aquaviário)
// ============================================

model MDFeMDFeTransp {
  id                    String    @id @default(cuid())
  munDescargaId         String
  munDescarga           MunDescargaMDFe @relation(fields: [munDescargaId], references: [id])
  chMDFe                String    @db.Char(44)
  indReentrega          Boolean?  @default(false)
  
  // === UNIDADES DE TRANSPORTE ===
  unidadesTransporte    MDFeUnidadeTransp[]
  
  // === PRODUTOS PERIGOSOS ===
  perigosos             MDFePerigoso[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_mdfes_transp")
  @@index([munDescargaId])
  @@index([chMDFe])
  @@unique([munDescargaId, chMDFe])
}

// ============================================
// UNIDADE DE TRANSPORTE (Carreta/Reboque/Vagão)
// ============================================

model MDFeUnidadeTransp {
  id                    String    @id @default(cuid())
  tpUnidTransp          String    @db.Char(1)  // 1=Tração, 2=Reboque, 3=Navio, 4=Balsa, 5=Aeronave, 6=Vagão, 7=Outros
  idUnidTransp          String    @db.VarChar(20)
  
  // === LACRES DA UNIDADE ===
  lacres                MDFeLacreUnidade[]
  
  // === UNIDADES DE CARGA ===
  unidadesCarga         MDFeUnidadeCarga[]
  
  // === RELACIONAMENTOS POLIMÓRFICOS ===
  cteId                 String?   // Referência ao MDFeCTe
  cte                   MDFeCTe?  @relation("CTeUnidades", fields: [cteId], references: [id])
  nfeId                 String?   // Referência ao MDFeNFe
  nfe                   MDFeNFe?  @relation("NFeUnidades", fields: [nfeId], references: [id])
  mdfeTranspId          String?   // Referência ao MDFeMDFeTransp
  mdfeTransp            MDFeMDFeTransp? @relation("MDFeTranspUnidades", fields: [mdfeTranspId], references: [id])
  
  qtdRat                Decimal?  @db.Decimal(15, 4) // Quantidade rateada
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_unidades_transporte")
  @@index([cteId])
  @@index([nfeId])
  @@index([mdfeTranspId])
}

// ============================================
// LACRE DA UNIDADE DE TRANSPORTE
// ============================================

model MDFeLacreUnidade {
  id                    String    @id @default(cuid())
  unidadeTranspId       String
  unidadeTransp         MDFeUnidadeTransp @relation(fields: [unidadeTranspId], references: [id])
  nLacre                String    @db.VarChar(20)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_lacres_unidade")
  @@index([unidadeTranspId])
}

// ============================================
// UNIDADE DE CARGA (Container/ULD/Pallet)
// ============================================

model MDFeUnidadeCarga {
  id                    String    @id @default(cuid())
  unidadeTranspId       String
  unidadeTransp         MDFeUnidadeTransp @relation(fields: [unidadeTranspId], references: [id])
  tpUnidCarga           String    @db.Char(1)  // 1=Container, 2=ULD, 3=Pallet, 4=Outros
  idUnidCarga           String    @db.VarChar(20)
  
  // === LACRES DA UNIDADE DE CARGA ===
  lacres                MDFeLacreUnidadeCarga[]
  
  qtdRat                Decimal?  @db.Decimal(15, 4) // Quantidade rateada
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_unidades_carga")
  @@index([unidadeTranspId])
}

// ============================================
// LACRE DA UNIDADE DE CARGA
// ============================================

model MDFeLacreUnidadeCarga {
  id                    String    @id @default(cuid())
  unidadeCargaId        String
  unidadeCarga          MDFeUnidadeCarga @relation(fields: [unidadeCargaId], references: [id])
  nLacre                String    @db.VarChar(20)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_lacres_unidade_carga")
  @@index([unidadeCargaId])
}

// ============================================
// PRODUTO PERIGOSO
// ============================================

model MDFePerigoso {
  id                    String    @id @default(cuid())
  nONU                  String    @db.VarChar(4)  // 4 dígitos ou "ND"
  xNomeAE               String?   @db.VarChar(150)
  xClaRisco             String?   @db.VarChar(40)
  grEmb                 String?   @db.VarChar(6)
  qTotProd              String    @db.VarChar(20)
  qVolTipo              String?   @db.VarChar(60)
  
  // === RELACIONAMENTOS POLIMÓRFICOS ===
  cteId                 String?   // Referência ao MDFeCTe
  cte                   MDFeCTe?  @relation("CTePerigosos", fields: [cteId], references: [id])
  nfeId                 String?   // Referência ao MDFeNFe
  nfe                   MDFeNFe?  @relation("NFePerigosos", fields: [nfeId], references: [id])
  mdfeTranspId          String?   // Referência ao MDFeMDFeTransp
  mdfeTransp            MDFeMDFeTransp? @relation("MDFeTranspPerigosos", fields: [mdfeTranspId], references: [id])
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_perigosos")
  @@index([cteId])
  @@index([nfeId])
  @@index([mdfeTranspId])
}

// ============================================
// NFe PRESTAÇÃO PARCIAL
// ============================================

model MDFeNFePrestParcial {
  id                    String    @id @default(cuid())
  cteId                 String
  cte                   MDFeCTe   @relation(fields: [cteId], references: [id])
  chNFe                 String    @db.Char(44)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_nfes_prest_parcial")
  @@index([cteId])
  @@unique([cteId, chNFe])
}

// ============================================
// SEGURO DA CARGA
// ============================================

model SeguroMDFe {
  id                    String    @id @default(cuid())
  mdfeId                String
  mdfe                  MDFe      @relation(fields: [mdfeId], references: [id])
  
  // === RESPONSÁVEL ===
  respSeg               String    @db.Char(1)  // 1=Emitente, 2=Contratante
  respCNPJ              String?   @db.Char(14)
  respCPF               String?   @db.Char(11)
  
  // === SEGURADORA ===
  xSeg                  String?   @db.VarChar(30)
  CNPJSeg               String?   @db.Char(14)
  
  // === APÓLICE E AVERBAÇÕES ===
  nApol                 String?   @db.VarChar(20)
  nAver                 String[]  @db.Text  // Array de números de averbação
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_seguros")
  @@index([mdfeId])
}

// ============================================
// LACRES DO MDF-e
// ============================================

model LacreMDFe {
  id                    String    @id @default(cuid())
  mdfeId                String
  mdfe                  MDFe      @relation(fields: [mdfeId], references: [id])
  nLacre                String    @db.VarChar(60)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_lacres")
  @@index([mdfeId])
}

// ============================================
// AUTORIZADOS PARA DOWNLOAD
// ============================================

model AutXMLMDFe {
  id                    String    @id @default(cuid())
  mdfeId                String
  mdfe                  MDFe      @relation(fields: [mdfeId], references: [id])
  CNPJ                  String?   @db.Char(14)
  CPF                   String?   @db.Char(11)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_aut_xml")
  @@index([mdfeId])
}

// ============================================
// ENCERRAMENTO DO MDF-e
// ============================================

model EncerramentoMDFe {
  id                    String    @id @default(cuid())
  mdfeId                String    @unique
  mdfe                  MDFe      @relation(fields: [mdfeId], references: [id])
  nProt                 String    @db.Char(17)
  dhEnc                 DateTime
  xMunEnc               String    @db.VarChar(60)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_encerramentos")
}

// ============================================
// HISTÓRICO DE STATUS DO MDF-e
// ============================================

model HistoricoStatusMDFe {
  id                    String    @id @default(cuid())
  mdfeId                String
  mdfe                  MDFe      @relation(fields: [mdfeId], references: [id])
  statusAnterior        StatusMDFe
  statusNovo            StatusMDFe
  dataHora              DateTime  @default(now())
  usuario               String
  motivo                String?   @db.VarChar(500)
  createdAt             DateTime  @default(now())

  @@map("mdfe_historico_status")
  @@index([mdfeId])
}

// ============================================
// LOTE DE MDF-e
// ============================================

model LoteMDFe {
  id                    String    @id @default(cuid())
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  numeroLote            Int
  quantidade            Int
  ambiente              String    @default("1") @db.Char(1) // 1=Produção, 2=Homologação
  versao                String    @default("3.00") @db.VarChar(5)
  situacao              String    @default("PROCESSANDO")  // PROCESSANDO, AUTORIZADO, REJEITADO
  protocolo             String?   @db.VarChar(15)
  xmlEnvio              String    @db.Text
  xmlRetorno            String?   @db.Text
  dataHora              DateTime  @default(now())
  dataHoraAutorizacao   DateTime?
  reciboLote            String?   @db.VarChar(15)
  mdfes                 MDFe[]    @relation("LoteMDFe")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("lotes_mdfe")
  @@index([empresaId])
  @@index([situacao])
}
