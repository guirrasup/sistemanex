// ============================================
// CT-e NO MDF-e
// ============================================

model MDFeCTe {
  id                    String    @id @default(cuid())
  munDescargaId         String
  munDescarga           MunDescargaMDFe @relation(fields: [munDescargaId], references: [id])
  chCTe                 String    @db.Char(44)
  SegCodBarra           String?   @db.VarChar(60)
  indReentrega          Boolean?  @default(false)
  
  // === UNIDADES DE TRANSPORTE ===
  unidadesTransporte    MDFeUnidadeTransp[]
  
  // === PRODUTOS PERIGOSOS ===
  perigosos             MDFePerigoso[]
  
  // === ENTREGA PARCIAL ===
  qtdTotal              Decimal?  @db.Decimal(15, 4)
  qtdParcial            Decimal?  @db.Decimal(15, 4)
  
  // === PRESTAÇÃO PARCIAL ===
  indPrestacaoParcial   Boolean?  @default(false)
  nfesParciais          MDFeNFePrestParcial[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_ctes")
