  qtdParcial            Decimal?  @db.Decimal(15, 4)
  
  // === PRESTAÇÃO PARCIAL ===
  indPrestacaoParcial   Boolean?  @default(false)
  nfesParciais          MDFeNFePrestParcial[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfe_ctes")
  @@index([munDescargaId])
  @@index([chCTe])
  @@unique([munDescargaId, chCTe])
}

