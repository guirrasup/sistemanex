// ============================================
// EVENTOS (para completar a NF-e)
// ============================================

model EventoNFe {
  id                    String    @id @default(cuid())
  
  // === TChNFe (44 dígitos) ===
  chaveNFe              String    @db.Char(44)
  
  // === TpAutor (1,2,3,5,6,9) ===
  tpAutor               Int
  
  // === Tipo Evento (ex: 110111 = Cancelamento) ===
  tpEvento              String    @db.Char(6)
  
  // === nSeqEvento (1-2) ===
  nSeqEvento            Int       @default(1)
  
  // === TDateTimeUTC ===
  dhEvento              DateTime
  
  // === TStat (3 dígitos) ===
  cStat                 String    @db.Char(3)
  
  // === TMotivo ===
  xMotivo               String
  
  // === TRec (15 dígitos) ===
  nRec                  String?   @db.Char(15)
  
  // === TProt (15 ou 17 dígitos) ===
  nProt                 String?   @db.Char(17)
  
  // === TString - XML do evento ===
  xmlEvento             String    @db.Text
  
  // === TString - XML do retorno ===
  xmlRetorno            String?   @db.Text
  
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("eventos_nfe")
  @@index([chaveNFe])
}

// ============================================
// EVENTO DE CRÉDITO PRESUMIDO (detEvento)
// ============================================

model EventoCreditoPresumido {
  id                    String    @id @default(cuid())
  
  // === TChNFe (44 dígitos) ===
  chaveNFe              String    @db.Char(44)
  
  // === TpAutor (1 ou 2) ===
  tpAutor               Int       @default(1)
  
  // === TVerAplic (1-20 caracteres) ===
  verAplic              String
  
  // === TCodUfIBGE (2 dígitos) ===
  cOrgaoAutor           String    @db.Char(2)
  
  // === TDateTimeUTC ===
  dhEvento              DateTime
  
  // === TRec (15 dígitos) ===
  nRec                  String?   @db.Char(15)
  
  // === TProt (15 ou 17 dígitos) ===
  nProt                 String?   @db.Char(17)
  
  // === TString - XML do evento ===
  xmlEvento             String    @db.Text
  xmlRetorno            String?   @db.Text
  
  // === Itens do crédito presumido ===
  itens                 EventoCreditoPresumidoItem[]
  
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("eventos_credito_presumido")
  @@index([chaveNFe])
}

model EventoCreditoPresumidoItem {
  id                    String    @id @default(cuid())
  
  // === TnItem (1-999) ===
  nItem                 String    // 1-999 com regras específicas
  
  // === TDec_1302 (15 dígitos, 13 inteiros, 2 decimais) ===
  vBCCredPres           Decimal   @db.Decimal(15, 2)
  
  // === Código Crédito Presumido (2 dígitos) ===
  cCredPres             String    @db.Char(2)
  
  // === TDec_0302_04 (3 inteiros, 2-4 decimais) ===
  pCredPresIBS          Decimal?  @db.Decimal(7, 4)
  vCredPresIBS          Decimal?  @db.Decimal(15, 2) // TDec1302
  
  pCredPresCBS          Decimal?  @db.Decimal(7, 4)
  vCredPresCBS          Decimal?  @db.Decimal(15, 2) // TDec1302
  
  eventoId              String
  evento                EventoCreditoPresumido @relation(fields: [eventoId], references: [id])
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("eventos_credito_presumido_itens")
  @@unique([eventoId, nItem])
}