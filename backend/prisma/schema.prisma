  xmlAssinado           String    @db.Text
  
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  
  remetente             Cliente   @relation("CTeRemetente", fields: [remetenteId], references: [id])
  destinatario          Cliente   @relation("CTeDestinatario", fields: [destinatarioId], references: [id])
  
