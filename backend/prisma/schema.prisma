  nfeId                 String?   // Referência ao MDFeNFe
  nfe                   MDFeNFe?  @relation("NFePerigosos", fields: [nfeId], references: [id])
  mdfeTranspId          String?   // Referência ao MDFeMDFeTransp
  mdfeTransp            MDFeMDFeTransp? @relation("MDFeTranspPerigosos", fields: [mdfeTranspId], references: [id])
  
