generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum TipoPessoa {
  PF
  PJ
  EXTERIOR
}

enum TipoCliente {
  CLIENTE
  FORNECEDOR
  AMBOS
}

enum StatusDocumento {
  RASCUNHO
  VALIDADA
  ASSINADA
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  DENEGADA
  SUBSTITUIDA
}

enum TipoAmbiente {
  PRODUCAO
  HOMOLOGACAO
}

enum StatusTitulo {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

enum TipoTitulo {
  RECEBER
  PAGAR
}

enum CategoriaFinanceira {
  VENDA_PRODUTOS
  PRESTACAO_SERVICOS
  COMPRA_MERCADORIAS
  FOLHA_PAGAMENTO
  IMPOSTOS_TRIBUTOS
  ALUGUEL_INFRA
  MARKETING_VENDAS
  DESPESAS_ADMINISTRATIVAS
  OUTRAS_RECEITAS
  OUTRAS_DESPESAS
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  SIMPLES_EXCESSO
  NORMAL
}

enum TipoMovimentacaoEstoque {
  ENTRADA_COMPRA
  SAIDA_VENDA
  SAIDA_NFE
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  INVENTARIO
}

enum PerfilUsuario {
  ADMIN
  FISCAL
  OPERADOR
}

// ============================================
// ENUMS DO CT-e
// ============================================

enum StatusCTe {
  RASCUNHO
  VALIDADA
  ASSINADA
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  DENEGADA
}

enum ModalCTe {
  RODOVIARIO   // 01
  AEREO        // 02
  AQUAVIARIO   // 03
  FERROVIARIO  // 04
  DUTOVIARIO   // 05
  MULTIMODAL   // 06
}

enum TipoServicoCTe {
  NORMAL              // 0
  SUBCONTRATACAO      // 1
  REDESPACHO          // 2
  REDESPACHO_INTERMEDIARIO // 3
  VINCULADO_MULTIMODAL // 4
}

enum TipoCTe {
  NORMAL              // 0
  COMPLEMENTO_VALORES // 1
  SUBSTITUICAO        // 3
}

enum TomadorServicoCTe {
  REMETENTE    // 0
  EXPEDIDOR    // 1
  RECEBEDOR    // 2
  DESTINATARIO // 3
  OUTROS       // 4
}

enum IndicadorIECTe {
  CONTRIBUINTE  // 1
  ISENTO        // 2
  NAO_CONTRIBUINTE // 9
}

enum CSTICMSCTe {
  TRIBUTACAO_NORMAL   // 00
  REDUCAO_BC          // 20
  ISENTA              // 40
  NAO_TRIBUTADA       // 41
  DIFERIDA            // 51
  ST                  // 60
  OUTROS              // 90
}

// ============================================
// ENUMS NFA-e
// ============================================

enum StatusNFAe {
  RASCUNHO
  VALIDADA
  ASSINADA
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
}

enum MotivoEmissaoNFAe {
  PRODUTOR_RURAL
  MEI_SEM_IE
  PF_ATIVO_PESSOAL
  FEIRAS_EVENTOS
  DEVOLUCAO_AVULSA
  OUTROS
}

enum TipoPessoaNFAe {
  PF
  PJ
}

// ============================================
// TABELAS PRINCIPAIS
// ============================================

model Empresa {
  id                    String    @id @default(cuid())
  razaoSocial           String
  nomeFantasia          String?
  cnpj                  String    @unique @db.Char(14)
  inscricaoEstadual     String?
  inscricaoEstadualST   String?
  inscricaoMunicipal    String?
  cnae                  String?
  regimeTributario      RegimeTributario @default(SIMPLES_NACIONAL)
  aliquotaSimples       Decimal?  @db.Decimal(5, 2) @default(6.00)
  ambienteEmissao       TipoAmbiente @default(PRODUCAO)

  // === DADOS DA UF E MUNICÍPIO ===
  uf                    String    @db.Char(2)
  codigoUF              String    @db.Char(2)
  codigoMunicipio       String    @db.Char(7)
  nomeMunicipio         String

  // === TIPO DE EMISSÃO (MANUAL - SEÇÃO III) ===
  tipoEmissao           String    @default("1") @db.Char(1)   // 1=Normal, 2=Contingência FS, 3=Regime Especial, 4=DPEC, 5=FSDA, 6=SVC-AN, 7=SVC-RS, 9=Off-line
  justificativaContingencia String? @db.VarChar(256)

  // === NUMERAÇÃO POR SÉRIE ===
  serieNfe              Int       @default(1)
  proximoNumeroNfe      Int       @default(1)
  serieNfeAno           Int       @default(0)
  proximoNumeroNfeAno   Int       @default(1)
  serieNfse             Int       @default(1)
  proximoNumeroNfse     Int       @default(1)
  serieNfce             Int       @default(1)
  proximoNumeroNfce     Int       @default(1)
  serieCte              Int       @default(1)
  proximoNumeroCte      Int       @default(1)
  serieNfae             Int       @default(900)
  proximoNumeroNfae     Int       @default(1)

  // === CONFIGURAÇÕES DE PAGAMENTO ===
  chavePixPadrao        String?
  bancoPadrao           String?

  // === CONFIGURAÇÕES DE TRIBUTAÇÃO ===
  optanteSimples        Boolean   @default(true)
  optanteMEI            Boolean   @default(false)

  // === TOKEN CSC (NFCe) ===
  tokenCSC              String?   @db.VarChar(36)
  tokenCSCId            String?   @db.VarChar(2)

  // === CONFIGURAÇÕES DE AMBIENTE SEFAZ ===
  homologacaoWebService String?   @db.Text
  producaoWebService    String?   @db.Text
  homologacaoQrCode     String?   @db.Text
  producaoQrCode        String?   @db.Text

  // === NUMERAÇÃO MDF-e ===
  serieMdfe              Int       @default(1)
  proximoNumeroMdfe      Int       @default(1)
  serieMdfeAno           Int       @default(0)
  proximoNumeroMdfeAno   Int       @default(1)
  
  // === RELACIONAMENTOS MDF-e ===
  mdfes                  MDFe[]
  lotesMDFe              LoteMDFe[]
  
  // === RELACIONAMENTOS ===
  enderecoId            String    @unique
  endereco              Endereco  @relation(fields: [enderecoId], references: [id])
  certificadoId         String?   @unique
  certificado           CertificadoDigital? @relation(fields: [certificadoId], references: [id])

  usuarios              Usuario[]
  clientes              Cliente[]
  produtos              Produto[]
  servicos              Servico[]
  nfses                 NFSe[]
  nfes                  NFe[]
  nfces                 NFCe[]
  ctes                  CTe[]
  nfaes                 NFAe[]
  titulos               TituloFinanceiro[]
  movimentacoes         MovimentacaoEstoque[]
  transportadoras       Transportadora[]
  eventosNFe            EventoNFe[]
  eventosCreditoPresumido EventoCreditoPresumido[]
  inutilizacoes         InutilizacaoNFe[]
  lotes                 LoteNFe[]
  envios                EnvioNFe[]
  agendamentos          AgendamentoBusca[]
  configuracaoAmbiente  ConfiguracaoAmbiente?
  parametros            ParametroSistema?
  historicoBackup       HistoricoBackup[]
  logs                  LogAcao[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("empresas")
}

model Endereco {
  id                String    @id @default(cuid())
  logradouro        String
  numero            String
  complemento       String?
  bairro            String
  codigoMunicipio   String    @db.Char(7)
  nomeMunicipio     String
  uf                String    @db.Char(2)
  codigoUF          String    @db.Char(2)
  cep               String    @db.Char(9)
  telefone          String?
  email             String?
  codigoPais        String?   @default("1058") @db.Char(4)
  nomePais          String?   @default("BRASIL")
  empresa           Empresa?
  cliente           Cliente?
  transportadora    Transportadora?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("enderecos")
}

model CertificadoDigital {
  id                    String    @id @default(cuid())
  tipo                  String    @default("A1")
  nomeTitular           String
  cnpjCpf               String
  emissora              String
  dataValidadeInicio    DateTime
  dataValidadeFim       DateTime
  diasRestantes         Int
  arquivoCarregadoNome  String?
  status                String    @default("VALIDO")
  arquivoBase64         String?   @db.Text
  senha                 String?   @db.Text
  empresa               Empresa?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("certificados_digitais")
}

model Usuario {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  senhaHash         String    @db.Text
  cargo             String?
  perfil            PerfilUsuario @default(OPERADOR)
  ativo             Boolean   @default(true)
  ultimoLogin       DateTime?
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  logs              LogAcao[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("usuarios")
}

// ============================================
// LOG DE AÇÕES (RASTREABILIDADE)
// ============================================

model LogAcao {
  id                    String    @id @default(cuid())
  usuarioId             String
  usuario               Usuario   @relation(fields: [usuarioId], references: [id])
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  acao                  String                                // ASSINAR, TRANSMITIR, CANCELAR, INUTILIZAR, IMPRIMIR, VALIDAR, EXPORTAR, IMPORTAR, EXCLUIR
  entidade              String                                // NFe, NFCe, CTe, NFSe, Cliente, Produto, Transportadora
  entidadeId            String
  dadosAntigos          String?   @db.Json
  dadosNovos            String?   @db.Json
  ipOrigem              String?   @db.VarChar(45)
  dataHora              DateTime  @default(now())

  @@map("logs_acao")
  @@index([empresaId])
  @@index([entidade, entidadeId])
}

// ============================================
// SCHEMA VERSION (CONTROLE DE VERSÃO)
// ============================================

model SchemaVersion {
  id                    String    @id @default(cuid())
  versao                String                                // "4.0.0"
  dataAtualizacao       DateTime  @default(now())
  descricao             String

  @@map("schema_version")
}

// ============================================
// CLIENTE / DESTINATÁRIO (MANUAL - VI)
// ============================================

model Cliente {
  id                    String    @id @default(cuid())
  tipo                  TipoCliente @default(CLIENTE)
  tipoPessoa            TipoPessoa @default(PJ)
  documento             String    @unique
  razaoSocial           String
  nomeFantasia          String?
  inscricaoEstadual     String?
  inscricaoEstadualST   String?
  inscricaoMunicipal    String?
  inscricaoSuframa      String?   @db.Char(9)

  // === INDICADOR IE (MANUAL - SEÇÃO VI) ===
  indIEDest             String    @default("9") @db.Char(1)   // 1=Contribuinte ICMS, 2=Isento, 9=Não contribuinte

  email                 String?
  telefone              String?
  celularWhatsApp       String?
  contato               String?
  observacoes           String?
  ativo                 Boolean   @default(true)

  enderecoId            String    @unique
  endereco              Endereco  @relation(fields: [enderecoId], references: [id])

  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  titulos               TituloFinanceiro[]
  nfsesTomador          NFSe[]    @relation("NFSeTomador")
  nfesDestinatario      NFe[]     @relation("NFeDestinatario")
  nfcesConsumidor       NFCe[]    @relation("NFCeConsumidor")
  cteRemetente          CTe[]     @relation("CTeRemetente")
  cteDestinatario       CTe[]     @relation("CTeDestinatario")
  nfaesDestinatario     NFAe[]    @relation("NFAeDestinatario")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // === MDF-e ===
  mdfesEmitente          MDFe[]    @relation("MDFeEmitente")

  @@map("clientes")
}

// ============================================
// PRODUTO
// ============================================

model Produto {
  id                    String    @id @default(cuid())
  codigo                String    @unique
  codigoBarrasEAN       String?
  descricao             String
  categoria             String
  unidade               String    @default("UN")
  uTrib                 String?   @db.VarChar(6)              // Unidade tributável (MANUAL V.1)
  ncm                   String    @db.Char(8)
  cest                  String?   @db.Char(7)
  cfopPadrao            String    @default("5102") @db.Char(4)
  origem                String    @default("0") @db.Char(1)

  precoCusto            Decimal   @db.Decimal(15, 4) @default(0)
  margemLucro           Decimal   @db.Decimal(5, 2) @default(0)
  precoVenda            Decimal   @db.Decimal(15, 4) @default(0)

  estoqueAtual          Decimal   @db.Decimal(11, 3) @default(0)
  estoqueMinimo         Decimal   @db.Decimal(11, 3) @default(0)
  estoqueMaximo         Decimal?  @db.Decimal(11, 3)

  aliquotaICMS          Decimal   @db.Decimal(5, 2) @default(18.00)
  aliquotaICMSST        Decimal?  @db.Decimal(5, 2)
  aliquotaPIS           Decimal   @db.Decimal(7, 4) @default(1.65)
  aliquotaCOFINS        Decimal   @db.Decimal(7, 4) @default(7.60)
  aliquotaIPI           Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaIBS           Decimal   @db.Decimal(7, 4) @default(0.10)
  aliquotaCBS           Decimal   @db.Decimal(7, 4) @default(0.90)

  cstICMS               String    @default("00") @db.Char(2)
  csosnICMS             String?   @db.Char(3)
  cstPIS                String    @default("01") @db.Char(2)
  cstCOFINS             String    @default("01") @db.Char(2)
  cstIPI                String?   @db.Char(2)

  modBC                 String    @default("3") @db.Char(1)
  modBCST               String    @default("4") @db.Char(1)
  pRedBC                Decimal?  @db.Decimal(5, 2)
  pMVAST                Decimal?  @db.Decimal(5, 2)
  pRedBCST              Decimal?  @db.Decimal(5, 2)

  ativo                 Boolean   @default(true)

  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  movimentacoes         MovimentacaoEstoque[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("produtos")
}

model Servico {
  id                          String    @id @default(cuid())
  codigoInterno               String    @unique
  descricao                   String
  codigoTributacaoNacional    String    @db.Char(6)
  codigoTributacaoMunicipal   String?   @db.Char(4)
  codigoNBS                   String?
  cListServ                   String    @db.Char(5)
  valorUnitario               Decimal   @db.Decimal(15, 4) @default(0)
  aliquotaISS                 Decimal   @db.Decimal(5, 2) @default(5.00)
  retencaoISSPadrao           Boolean   @default(false)
  aliquotaPIS                 Decimal   @db.Decimal(7, 4) @default(0.65)
  aliquotaCOFINS              Decimal   @db.Decimal(7, 4) @default(3.00)
  aliquotaIRRF                Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaCSLL                Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaINSS                Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaIBS                 Decimal   @db.Decimal(7, 4) @default(0.10)
  aliquotaCBS                 Decimal   @db.Decimal(7, 4) @default(0.90)
  ativo                       Boolean   @default(true)
  empresaId                   String
  empresa                     Empresa   @relation(fields: [empresaId], references: [id])
  nfses                       NFSe[]
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@map("servicos")
}

// ============================================
// NFS-e - NOTA FISCAL DE SERVIÇOS ELETRÔNICA
// PADRÃO NACIONAL v1.01 - COMPLETO
// ============================================

model NFSe {
  id                    String    @id @default(cuid())
  
  // === IDENTIFICAÇÃO DA NFS-e ===
  chaveAcesso           String    @unique @db.Char(53)
  numeroNfse            Int
  serieDPS              Int       @default(1)
  numeroDPS             Int
  codigoVerificacao     String    @db.Char(9)
  
  // === DATAS ===
  dataCompetencia       DateTime
  dataHoraEmissao       DateTime
  dataHoraProcessamento DateTime
  
  // === AMBIENTE E EMISSÃO ===
  ambiente              TipoAmbiente @default(PRODUCAO)
  tipoEmissao           String    @default("1") @db.Char(1)
  status                StatusDocumento @default(PROCESSANDO)
  
  // === DADOS DO PRESTADOR (EMITENTE) ===
  prestadorCnpj         String    @db.Char(14)
  prestadorInscricaoMunicipal String
  prestadorRazaoSocial  String
  prestadorNomeFantasia String?
  prestadorRegimeTributario Int    @default(1)        // 1=Simples, 2=Normal
  prestadorOptanteSimples Boolean @default(true)
  prestadorRegimeEspecial String? @db.Char(1)
  
  // === ENDEREÇO DO PRESTADOR ===
  prestadorLogradouro   String
  prestadorNumero       String
  prestadorComplemento  String?
  prestadorBairro       String
  prestadorCodigoMunicipio String @db.Char(7)
  prestadorNomeMunicipio String
  prestadorUf           String   @db.Char(2)
  prestadorCep          String   @db.Char(9)
  prestadorTelefone     String?
  prestadorEmail        String?
  
  // === DADOS DO TOMADOR ===
  tomadorTipoPessoa     String   @db.Char(2)          // PF, PJ, EX
  tomadorDocumento      String   @db.VarChar(14)
  tomadorRazaoSocial    String
  tomadorNomeFantasia   String?
  tomadorInscricaoMunicipal String?
  tomadorInscricaoEstadual String?
  tomadorIndicadorIE    String   @default("9") @db.Char(1) // 1=Contribuinte, 2=Isento, 9=Não contribuinte
  tomadorEmail          String?
  tomadorTelefone       String?
  
  // === ENDEREÇO DO TOMADOR ===
  tomadorLogradouro     String
  tomadorNumero         String
  tomadorComplemento    String?
  tomadorBairro         String
  tomadorCodigoMunicipio String @db.Char(7)
  tomadorNomeMunicipio  String
  tomadorUf             String   @db.Char(2)
  tomadorCep            String   @db.Char(9)
  tomadorCodigoPais     String?  @db.Char(4)
  tomadorNomePais       String?
  
  // === DADOS DO SERVIÇO ===
  codigoTributacaoNacional String @db.Char(6)
  codigoTributacaoMunicipal String @db.Char(4)
  descricaoServico      String   @db.VarChar(2000)
  codigoNBS             String   @db.VarChar(15)
  codigoInterno         String?
  
  // === LOCAL DA PRESTAÇÃO ===
  localPrestacaoCodigoMunicipio String @db.Char(7)
  localPrestacaoNomeMunicipio String
  localPrestacaoUf     String   @db.Char(2)
  
  // === VALORES DO SERVIÇO ===
  valorServico          Decimal  @db.Decimal(15, 4)
  descontoIncondicionado Decimal  @db.Decimal(15, 4) @default(0)
  descontoCondicionado  Decimal  @db.Decimal(15, 4) @default(0)
  deducoesMateriais     Decimal  @db.Decimal(15, 4) @default(0)
  
  // === TRIBUTAÇÃO ISSQN ===
  tributacaoISSQN       Int      @default(1)           // 1=Tributável, 2=Imune, 3=Exportação, 4=Não Incidência
  aliquotaISS           Decimal  @db.Decimal(5, 2)
  baseCalculoISS        Decimal  @db.Decimal(15, 4)
  valorISS              Decimal  @db.Decimal(15, 4)
  tipoRetencaoISS       Int      @default(1)           // 1=Não Retido, 2=Retido Tomador, 3=Retido Intermediário
  valorISSRetido        Decimal  @db.Decimal(15, 4) @default(0)
  
  // === RETENÇÕES FEDERAIS ===
  aliquotaPIS           Decimal  @db.Decimal(7, 4) @default(0)
  valorPIS              Decimal  @db.Decimal(15, 4) @default(0)
  retidoPIS             Boolean  @default(false)
  
  aliquotaCOFINS        Decimal  @db.Decimal(7, 4) @default(0)
  valorCOFINS           Decimal  @db.Decimal(15, 4) @default(0)
  retidoCOFINS          Boolean  @default(false)
  
  aliquotaIRRF          Decimal  @db.Decimal(5, 2) @default(0)
  valorIRRF             Decimal  @db.Decimal(15, 4) @default(0)
  
  aliquotaCSLL          Decimal  @db.Decimal(5, 2) @default(0)
  valorCSLL             Decimal  @db.Decimal(15, 4) @default(0)
  
  aliquotaINSS          Decimal  @db.Decimal(5, 2) @default(0)
  valorINSS             Decimal  @db.Decimal(15, 4) @default(0)
  
  valorTotalRetencoesFederais Decimal @db.Decimal(15, 4) @default(0)
  
  // === IBS/CBS (Reforma 2026) ===
  // IBS - UF
  aliquotaIBSUF         Decimal  @db.Decimal(7, 4) @default(0.05)
  valorIBSUF            Decimal  @db.Decimal(15, 4) @default(0)
  
  // IBS - Municipal
  aliquotaIBSMun        Decimal  @db.Decimal(7, 4) @default(0.05)
  valorIBSMun           Decimal  @db.Decimal(15, 4) @default(0)
  valorTotalIBS         Decimal  @db.Decimal(15, 4) @default(0)
  
  // CBS
  aliquotaCBS           Decimal  @db.Decimal(7, 4) @default(0.90)
  valorCBS              Decimal  @db.Decimal(15, 4) @default(0)
  
  // === TOTAIS ===
  valorTotalServicos    Decimal  @db.Decimal(15, 4)
  valorTotalDescontos   Decimal  @db.Decimal(15, 4) @default(0)
  valorTotalDeducoes    Decimal  @db.Decimal(15, 4) @default(0)
  valorTotalISS         Decimal  @db.Decimal(15, 4)
  valorTotalISSRetido   Decimal  @db.Decimal(15, 4) @default(0)
  valorLiquidoNfse      Decimal  @db.Decimal(15, 4)
  valorTotalNotaFinal   Decimal  @db.Decimal(15, 4)
  
  // === PAGAMENTO VINCULADO ===
  pagamentoNumero       Int?
  pagamentoIdTransacao  String?  @db.VarChar(50)
  pagamentoTipoMeio     String?  @db.VarChar(10)
  pagamentoCnpjRecebedor String? @db.Char(14)
  pagamentoCnpjBasePSP  String?  @db.VarChar(8)
  
  // === INFORMAÇÕES ADICIONAIS ===
  informacoesComplementares String? @db.VarChar(2000)
  numeroPedido           String?  @db.VarChar(30)
  urlVisualizacaoNacional String?
  
  // === INDICADORES ===
  indISS                String   @default("1") @db.Char(1)
  indIncentivo          String   @default("2") @db.Char(1)
  
  // === PROTOCOLOS E STATUS ===
  protocoloAutorizacao  String?  @db.VarChar(15)
  dataHoraAutorizacao   DateTime?
  motivoCancelamento    String?  @db.VarChar(255)
  dataHoraCancelamento  DateTime?
  chaveNfseSubstituta   String?  @db.Char(53)
  motivoRejeicao        String?  @db.VarChar(500)
  dataHoraRejeicao      DateTime?
  
  // === XMLs ===
  xmlAssinado           String   @db.Text
  xmlRetorno            String?  @db.Text
  xmlDPS                String?  @db.Text
  xmlCNC                String?  @db.Text
  
  // === CONTROLE ===
  enviadoEm             DateTime?
  enviadoPor            String?
  ipEnvio               String?  @db.VarChar(45)
  
  // === RELACIONAMENTOS ===
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  tomadorId             String?
  tomador               Cliente?  @relation("NFSeTomador", fields: [tomadorId], references: [id])
  servicoId             String?
  servico               Servico?  @relation(fields: [servicoId], references: [id])
  historicoStatus       HistoricoStatusNFSe[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("nfses")
  @@index([empresaId])
  @@index([chaveAcesso])
  @@index([status])
  @@index([tomadorId])
  @@index([dataHoraEmissao])
  @@index([protocoloAutorizacao])
  @@index([numeroNfse, serieDPS])
}

