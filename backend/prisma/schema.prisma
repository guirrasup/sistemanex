// ============================================
// CT-e NO MDF-e
// ============================================

model MDFeCTe {
  id                    String    @id @default(cuid())
  munDescargaId         String
  munDescarga           MunDescargaMDFe @relation(fields: [munDescargaId], references: [id])
  chCTe                 String    @db.Char(44)
