  valorTotalFrete       Decimal   @db.Decimal(15, 4)
  fretePeso             Decimal   @db.Decimal(15, 4)
  freteValor            Decimal   @db.Decimal(15, 4)
  pedagio               Decimal   @db.Decimal(15, 4) @default(0)
  taxaGris              Decimal   @db.Decimal(15, 4) @default(0)
  outrasTaxas           Decimal   @db.Decimal(15, 4) @default(0)
  valorReceber          Decimal   @db.Decimal(15, 4)
  
  cstICMS               String    @default("00") @db.Char(2)
  baseCalculoICMS       Decimal   @db.Decimal(15, 4)
  aliquotaICMS          Decimal   @db.Decimal(5, 2)
  valorICMS             Decimal   @db.Decimal(15, 4)
  valorPIS              Decimal   @db.Decimal(15, 4)
  valorCOFINS           Decimal   @db.Decimal(15, 4)
  valorTributosAprox    Decimal   @db.Decimal(15, 4) @default(0)
  
