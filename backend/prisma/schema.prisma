// ============================================
// NFAe - NOTA FISCAL AVULSA ELETRÔNICA
// ============================================


model NFAe {
  id                    String            @id @default(cuid())
  
  // === IDENTIFICAÇÃO ===
  modelo                String            @default("63") @db.Char(2)
  serie                 Int               @default(900)
  numero                Int
  chaveAcesso           String            @unique @db.Char(44)
  dataHoraEmissao       DateTime
  
  // === DADOS DA OPERAÇÃO ===
  naturezaOperacao      String            @db.VarChar(60)
  motivoEmissao         MotivoEmissaoNFAe
  descricaoMotivo       String            @db.VarChar(255)
  
  // === AMBIENTE E EMISSÃO ===
  ambiente              Int               @default(1) // 1=Produção, 2=Homologação
  tipoEmissao           String            @default("1") @db.Char(1) // 1=Normal, 2=Contingência
  status                StatusNFAe        @default(RASCUNHO)
  
  // === REQUERENTE (EMITENTE AVULSO) ===
  requerenteTipoPessoa  TipoPessoaNFAe    @default(PF)
  requerenteDocumento   String            @db.VarChar(14) // CPF ou CNPJ
  requerenteNome        String            @db.VarChar(60)
  requerenteInscricaoProdutor String?     @db.VarChar(20)
  requerenteLogradouro  String            @db.VarChar(60)
  requerenteNumero      String            @db.VarChar(10)
  requerenteComplemento String?           @db.VarChar(60)
  requerenteBairro      String            @db.VarChar(60)
  requerenteMunicipio   String            @db.VarChar(60)
  requerenteMunicipioIbge String?         @db.Char(7)
  requerenteUf          String            @db.Char(2)
  requerenteCep         String            @db.Char(9)
  requerenteTelefone    String?           @db.VarChar(14)
  requerenteEmail       String?           @db.VarChar(60)
  
  // === DESTINATÁRIO ===
  destinatarioTipoPessoa TipoPessoaNFAe   @default(PJ)
  destinatarioDocumento String            @db.VarChar(14)
  destinatarioNome      String            @db.VarChar(60)
  destinatarioIE        String?           @db.VarChar(14)
  destinatarioLogradouro String           @db.VarChar(60)
  destinatarioNumero    String            @db.VarChar(10)
  destinatarioComplemento String?         @db.VarChar(60)
  destinatarioBairro    String            @db.VarChar(60)
  destinatarioMunicipio String            @db.VarChar(60)
  destinatarioMunicipioIbge String?       @db.Char(7)
  destinatarioUf        String            @db.Char(2)
  destinatarioCep       String            @db.Char(9)
  destinatarioTelefone  String?           @db.VarChar(14)
  destinatarioEmail     String?           @db.VarChar(60)
  
  // === ITENS ===
  itens                 NFAeItem[]
  
  // === VALORES ===
  valorTotalProdutos    Decimal           @db.Decimal(15, 2)
  baseCalculoICMS       Decimal           @db.Decimal(15, 2)
  aliquotaICMSMediana   Decimal           @db.Decimal(5, 2)
  valorTotalICMS        Decimal           @db.Decimal(15, 2)
  valorTotalNota        Decimal           @db.Decimal(15, 2)
  
  // === GUIA DAE (Documento de Arrecadação Estadual) ===
  guiaDAENumero         String?           @db.VarChar(30)
  guiaDAECodigoBarras   String?           @db.VarChar(50)
  guiaDAEChavePix       String?           @db.VarChar(50)
  guiaDAEVencimento     DateTime?
  guiaDAEValor          Decimal?          @db.Decimal(15, 2)
  guiaDAEStatus         String?           @db.VarChar(20) // PAGO, AGUARDANDO_PAGAMENTO, ISENTO
  
  // === ÓRGÃO EMISSOR ===
  orgaoEmissorSefaz     String            @db.VarChar(60)
  
  // === PROTOCOLOS ===
  protocoloAutorizacao  String?           @db.Char(17)
  dataHoraAutorizacao   DateTime?
  motivoCancelamento    String?           @db.VarChar(255)
  dataHoraCancelamento  DateTime?
  motivoRejeicao        String?           @db.VarChar(500)
  dataHoraRejeicao      DateTime?
  
  // === XMLs ===
  xmlAssinado           String            @db.Text
  xmlRetorno            String?           @db.Text
  
  // === CONTROLE ===
  enviadoEm             DateTime?
  enviadoPor            String?
  ipEnvio               String?           @db.VarChar(45)
  
  // === INFORMAÇÕES ADICIONAIS ===
  informacoesComplementares String?       @db.VarChar(2000)
  
  // === RELACIONAMENTOS ===
  empresaId             String
  empresa               Empresa           @relation(fields: [empresaId], references: [id])
  destinatarioId        String?
  destinatario          Cliente?          @relation("NFAeDestinatario", fields: [destinatarioId], references: [id])
  historicoStatus       HistoricoStatusNFAe[]
  
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@map("nfaes")
  @@index([empresaId])
  @@index([chaveAcesso])
  @@index([status])
  @@index([numero, serie])
  @@index([destinatarioId])
}

