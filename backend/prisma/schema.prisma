  valorUnitario         Decimal   @db.Decimal(15, 4)
  vUnTrib               Decimal?  @db.Decimal(15, 4)          // Valor unitário tributável

  // === VALORES - LEIAUTE 4.00 ===
  vProd                 Decimal   @db.Decimal(15, 4)          // Valor total bruto
  vDesc                 Decimal   @db.Decimal(15, 4) @default(0) // Desconto
  vOutro                Decimal?  @db.Decimal(15, 4)          // Outras despesas

  // === GTIN ===
  codigoEAN             String?
  codigoEANTrib         String?
  cBarra                String?   @db.VarChar(30)
  cBarraTrib            String?   @db.VarChar(30)

  // === PEDIDO ===
  xPed                  String?   @db.VarChar(15)             // Número do pedido de compra
  nItemPed              Int?                                  // Número do item do pedido
  nFCI                  String?   @db.VarChar(36)

  // === ORIGEM ===
  origemMercadoria      String    @default("0") @db.Char(1)

  // === ICMS - LEIAUTE 4.00 ===
  cstICMS               String    @default("00") @db.Char(2)
  csosnICMS             String?   @db.Char(3)
  pICMS                 Decimal?  @db.Decimal(5, 2)            // Alíquota ICMS
  vBC                   Decimal?  @db.Decimal(15, 4)          // Base de cálculo ICMS
  vICMS                 Decimal?  @db.Decimal(15, 4)          // Valor ICMS
  pRedBC                Decimal?  @db.Decimal(5, 2)
  modBC                 String    @default("3") @db.Char(1)
  vBCFCP                Decimal?  @db.Decimal(15, 4)
  pFCP                  Decimal?  @db.Decimal(5, 2)
  vFCP                  Decimal?  @db.Decimal(15, 4)

  // === ICMS ST - LEIAUTE 4.00 ===
  vBCST                 Decimal?  @db.Decimal(15, 4)          // Base de cálculo ICMS ST
  pICMSST               Decimal?  @db.Decimal(5, 2)           // Alíquota ICMS ST
  vICMSST               Decimal?  @db.Decimal(15, 4)          // Valor ICMS ST
  pMVAST                Decimal?  @db.Decimal(5, 2)
  pRedBCST              Decimal?  @db.Decimal(5, 2)
  vBCFCPST              Decimal?  @db.Decimal(15, 4)
  pFCPST                Decimal?  @db.Decimal(5, 2)
  vFCPST                Decimal?  @db.Decimal(15, 4)

  // === IPI - LEIAUTE 4.00 ===
  cstIPI                String?   @db.Char(2)
  pIPI                  Decimal?  @db.Decimal(5, 2)           // Alíquota IPI
  vIPI                  Decimal?  @db.Decimal(15, 4)          // Valor IPI
  cEnqIPI               String?   @db.VarChar(3)

  // === PIS - LEIAUTE 4.00 ===
  cstPIS                String    @default("01") @db.Char(2)
  pPIS                  Decimal?  @db.Decimal(7, 4)           // Alíquota PIS
  vPIS                  Decimal?  @db.Decimal(15, 4)          // Valor PIS
  qBCProdPIS            Decimal?  @db.Decimal(15, 4)
  vAliqProdPIS          Decimal?  @db.Decimal(15, 4)
  vBCSTPIS              Decimal?  @db.Decimal(15, 4)
  pPISST                Decimal?  @db.Decimal(7, 4)
  vPISST                Decimal?  @db.Decimal(15, 4)

  // === COFINS - LEIAUTE 4.00 ===
  cstCOFINS             String    @default("01") @db.Char(2)
  pCOFINS               Decimal?  @db.Decimal(7, 4)           // Alíquota COFINS
  vCOFINS               Decimal?  @db.Decimal(15, 4)          // Valor COFINS
  qBCProdCOFINS         Decimal?  @db.Decimal(15, 4)
  vAliqProdCOFINS       Decimal?  @db.Decimal(15, 4)
  vBCSTCOFINS           Decimal?  @db.Decimal(15, 4)
  pCOFINSST             Decimal?  @db.Decimal(7, 4)
  vCOFINSST             Decimal?  @db.Decimal(15, 4)

  // === IBS e CBS ===
  pIBS                  Decimal?  @db.Decimal(7, 4)           // Alíquota IBS
  vIBS                  Decimal?  @db.Decimal(15, 4)          // Valor IBS
  pCBS                  Decimal?  @db.Decimal(7, 4)           // Alíquota CBS
  vCBS                  Decimal?  @db.Decimal(15, 4)          // Valor CBS

  // === TRIBUTOS ===
  vTotTrib              Decimal?  @db.Decimal(15, 4)          // Tributos aproximados

  // === INDICADOR ===
  indTot                String    @default("1") @db.Char(1)   // 0=Não compõe total, 1=Compõe

  // === INFORMAÇÕES ===
  infAdProd             String?   @db.VarChar(500)

  // === RELACIONAMENTOS ===
  nfeId                 String
  nfe                   NFe       @relation(fields: [nfeId], references: [id])

  rastreabilidade       ItemRastreabilidade[]
  declaracaoImportacao  DeclaracaoImportacao?
  detalheExportacao     DetalheExportacao?
  veiculo               VeiculoProduto?
  medicamento           Medicamento?
  armas                 Arma[]
  combustivel           Combustivel?

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("itens_nfe")
}

