// ============================================
// GENERATOR E DATASOURCE
// ============================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS (mantidos existentes)
// ============================================

enum TipoPessoa {
  PF
  PJ
  EXTERIOR
}

enum TipoCliente {
  CLIENTE
  FORNECEDOR
  AMBOS
}

enum StatusDocumento {
  RASCUNHO
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  SUBSTITUIDA
}

enum TipoAmbiente {
  PRODUCAO
  HOMOLOGACAO
}

enum StatusTitulo {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

enum TipoTitulo {
  RECEBER
  PAGAR
}

enum CategoriaFinanceira {
  VENDA_PRODUTOS
  PRESTACAO_SERVICOS
  COMPRA_MERCADORIAS
  FOLHA_PAGAMENTO
  IMPOSTOS_TRIBUTOS
  ALUGUEL_INFRA
  MARKETING_VENDAS
  DESPESAS_ADMINISTRATIVAS
  OUTRAS_RECEITAS
  OUTRAS_DESPESAS
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  SIMPLES_EXCESSO
  NORMAL
}

enum TipoMovimentacaoEstoque {
  ENTRADA_COMPRA
  SAIDA_VENDA
  SAIDA_NFE
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  INVENTARIO
}

enum PerfilUsuario {
  ADMIN
  FISCAL
  OPERADOR
}

// ============================================
// ENUMS ADICIONAIS DA NF-e
//
// TpImp, TpEmis, TpNF, IdDest, IndPresenca e TpAutor (tipos oficiais do
// layout técnico da NF-e) foram removidos daqui: a sintaxe usada
// ("NOME = 1") não é válida em enum do Prisma (que não aceita valores
// numéricos explícitos) e o schema não compilava. Nenhum campo do
// modelo usava esses enums como tipo — os campos reais são Int/String
// e os comentários abaixo em cada campo já documentam a correspondência
// com o código oficial.
// ============================================

// ============================================
// TABELAS PRINCIPAIS COM TIPOS CORRIGIDOS
// ============================================

model Empresa {
  id                    String    @id @default(cuid())
  razaoSocial           String
  nomeFantasia          String?
  
  // === TCnpj (14 dígitos) ===
  cnpj                  String    @unique @db.Char(14)
  
  // === TIe (2-14 dígitos ou ISENTO) ===
  inscricaoEstadual     String?
  inscricaoMunicipal    String?
  cnae                  String?
  regimeTributario      RegimeTributario @default(SIMPLES_NACIONAL)
  
  // === TDec_0302 (3 inteiros, 2 decimais) ===
  aliquotaSimples       Decimal?  @db.Decimal(5, 2) @default(6.00)
  
  // === TAmb (1=Produção, 2=Homologação) ===
  ambienteEmissao       TipoAmbiente @default(PRODUCAO)
  
  // === TSerie (0 ou 1-999) ===
  serieNfe              Int       @default(1)
  proximoNumeroNfe      Int       @default(1)
  serieNfse             Int       @default(1)
  proximoNumeroNfse     Int       @default(1)
  serieNfce             Int       @default(1)
  proximoNumeroNfce     Int       @default(1)
  serieCte              Int       @default(1)
  proximoNumeroCte      Int       @default(1)
  serieNfae             Int       @default(900)
  proximoNumeroNfae     Int       @default(1)
  
  chavePixPadrao        String?
  bancoPadrao           String?
  optanteSimples        Boolean   @default(true)
  optanteMEI            Boolean   @default(false)
  
  enderecoId            String    @unique
  endereco              Endereco  @relation(fields: [enderecoId], references: [id])
  
  certificadoId         String?   @unique
  certificado           CertificadoDigital? @relation(fields: [certificadoId], references: [id])
  
  usuarios              Usuario[]
  clientes              Cliente[]
  produtos              Produto[]
  servicos              Servico[]
  nfses                 NFSe[]
  nfes                  NFe[]
  nfces                 NFCe[]
  ctes                  CTe[]
  nfaes                 NFAe[]
  titulos               TituloFinanceiro[]
  movimentacoes         MovimentacaoEstoque[]
  transportadoras       Transportadora[]
  eventosNFe            EventoNFe[]
  eventosCreditoPresumido EventoCreditoPresumido[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("empresas")
}

model Endereco {
  id                String    @id @default(cuid())
  logradouro        String
  numero            String
  complemento       String?
  bairro            String
  
  // === TCodMunIBGE (7 dígitos) ===
  codigoMunicipio   String    @db.Char(7)
  nomeMunicipio     String
  
  // === TCodUfIBGE (2 dígitos) ===
  uf                String    @db.Char(2)
  
  // === TString com validação de CEP ===
  cep               String    @db.Char(9)
  telefone          String?
  email             String?
  
  // === Tpais (código BACEN) ===
  codigoPais        String?   @default("1058") @db.Char(4)
  nomePais          String?   @default("BRASIL")
  
  empresa           Empresa?
  cliente           Cliente?
  transportadora    Transportadora?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("enderecos")
}

model CertificadoDigital {
  id                    String    @id @default(cuid())
  tipo                  String    @default("A1")
  nomeTitular           String
  cnpjCpf               String
  emissora              String
  dataValidadeInicio    DateTime
  dataValidadeFim       DateTime
  diasRestantes         Int
  arquivoCarregadoNome  String?
  status                String    @default("VALIDO")
  arquivoBase64         String?   @db.Text
  
  empresa               Empresa?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("certificados_digitais")
}

model Usuario {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  senhaHash         String    @db.Text
  cargo             String?
  perfil            PerfilUsuario @default(OPERADOR)
  ativo             Boolean   @default(true)
  ultimoLogin       DateTime?
  
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  @@map("usuarios")
}

model Cliente {
  id                    String    @id @default(cuid())
  tipo                  TipoCliente @default(CLIENTE)
  
  // === TipoPessoa ===
  tipoPessoa            TipoPessoa @default(PJ)
  
  // === TCnpj ou TCpf (14 ou 11 dígitos) ===
  documento             String    @unique
  
  // === TString ===
  razaoSocial           String
  nomeFantasia          String?
  
  // === TIeDest (ISENTO ou 0-14 dígitos) ===
  inscricaoEstadual     String?
  
  // === TIeST (2-14 dígitos) - NOVO! ===
  inscricaoEstadualST   String?
  
  inscricaoMunicipal    String?
  
  // === Indicador IE (1=Contribuinte, 9=Não Contribuinte) ===
  indicadorIE           String    @default("9") @db.Char(1)
  
  email                 String?
  telefone              String?
  celularWhatsApp       String?
  contato               String?
  observacoes           String?
  ativo                 Boolean   @default(true)
  
  enderecoId            String    @unique
  endereco              Endereco  @relation(fields: [enderecoId], references: [id])
  
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  
  titulos               TituloFinanceiro[]
  
  nfsesTomador          NFSe[]    @relation("NFSeTomador")
  nfesDestinatario      NFe[]     @relation("NFeDestinatario")
  nfcesConsumidor       NFCe[]    @relation("NFCeConsumidor")
  cteRemetente          CTe[]     @relation("CTeRemetente")
  cteDestinatario       CTe[]     @relation("CTeDestinatario")
  nfaesDestinatario     NFAe[]    @relation("NFAeDestinatario")
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("clientes")
}

model Produto {
  id                    String    @id @default(cuid())
  codigo                String    @unique
  codigoBarrasEAN       String?
  descricao             String
  categoria             String
  
  // === Unidade (UN, KG, etc) ===
  unidade               String    @default("UN")
  
  // === NCM (8 dígitos) ===
  ncm                   String    @db.Char(8)
  
  // === CEST (7 dígitos) ===
  cest                  String?   @db.Char(7)
  
  // === CFOP (4 dígitos) ===
  cfopPadrao            String    @default("5102") @db.Char(4)
  
  // === Origem (0=Nacional, 1=Estrangeira, etc) ===
  origem                Int       @default(0)
  
  // === TDec_1104 (15 dígitos, 4 decimais) ===
  precoCusto            Decimal   @db.Decimal(15, 4) @default(0)
  margemLucro           Decimal   @db.Decimal(5, 2) @default(0) // TDec_0302
  precoVenda            Decimal   @db.Decimal(15, 4) @default(0)
  
  // === TDec_0803 (11 dígitos, 3 decimais) ===
  estoqueAtual          Decimal   @db.Decimal(11, 3) @default(0)
  estoqueMinimo         Decimal   @db.Decimal(11, 3) @default(0)
  
  // === TDec_0302_04 (3 inteiros, 2-4 decimais) ===
  aliquotaICMS          Decimal   @db.Decimal(5, 2) @default(18.00)
  aliquotaPIS           Decimal   @db.Decimal(7, 4) @default(1.65)
  aliquotaCOFINS        Decimal   @db.Decimal(7, 4) @default(7.60)
  aliquotaIPI           Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaIBS           Decimal   @db.Decimal(7, 4) @default(0.10)
  aliquotaCBS           Decimal   @db.Decimal(7, 4) @default(0.90)
  
  ativo                 Boolean   @default(true)
  
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  
  movimentacoes         MovimentacaoEstoque[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("produtos")
}

model Servico {
  id                          String    @id @default(cuid())
  codigoInterno               String    @unique
  descricao                   String
  codigoTributacaoNacional    String    @db.Char(6)
  codigoTributacaoMunicipal   String?   @db.Char(4)
  codigoNBS                   String?
  
  // === TDec_1104 (15 dígitos, 4 decimais) ===
  valorUnitario               Decimal   @db.Decimal(15, 4) @default(0)
  
  // === TDec_0302_04 ===
  aliquotaISS                 Decimal   @db.Decimal(5, 2) @default(5.00)
  retencaoISSPadrao           Boolean   @default(false)
  aliquotaPIS                 Decimal   @db.Decimal(7, 4) @default(0.65)
  aliquotaCOFINS              Decimal   @db.Decimal(7, 4) @default(3.00)
  aliquotaIRRF                Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaCSLL                Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaINSS                Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaIBS                 Decimal   @db.Decimal(7, 4) @default(0.10)
  aliquotaCBS                 Decimal   @db.Decimal(7, 4) @default(0.90)
  
  ativo                       Boolean   @default(true)
  
  empresaId                   String
  empresa                     Empresa   @relation(fields: [empresaId], references: [id])
  
  nfses                       NFSe[]
  
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt
  
  @@map("servicos")
}

// ============================================
// NFSe (mantido igual)
// ============================================

model NFSe {
  id                    String    @id @default(cuid())
  chaveAcesso           String    @unique @db.Char(53)
  numeroNfse            Int
  serieDPS              Int       @default(1)
  numeroDPS             Int
  dataCompetencia       DateTime
  dataHoraEmissao       DateTime
  dataHoraProcessamento DateTime
  codigoVerificacao     String    @db.Char(9)
  ambiente              TipoAmbiente @default(PRODUCAO)
  tipoEmissao           Int       @default(1)
  status                StatusDocumento @default(PROCESSANDO)
  
  // === TDec_1104 (15 dígitos, 4 decimais) ===
  valorTotalServicos    Decimal   @db.Decimal(15, 4)
  valorTotalDescontos   Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalDeducoes    Decimal   @db.Decimal(15, 4) @default(0)
  baseCalculoISS        Decimal   @db.Decimal(15, 4)
  valorTotalISS         Decimal   @db.Decimal(15, 4)
  valorTotalISSRetido   Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalRetencoesFed Decimal  @db.Decimal(15, 4) @default(0)
  valorTotalIBS         Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalCBS         Decimal   @db.Decimal(15, 4) @default(0)
  valorLiquidoNfse      Decimal   @db.Decimal(15, 4)
  valorTotalNotaFinal   Decimal   @db.Decimal(15, 4)
  
  informacoesComplementares String?
  numeroPedido           String?
  motivoCancelamento     String?
  dataHoraCancelamento   DateTime?
  chaveNfseSubstituta    String?
  
  xmlAssinado            String    @db.Text
  urlVisualizacao        String?
  
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  
  tomadorId             String
  tomador               Cliente   @relation("NFSeTomador", fields: [tomadorId], references: [id])
  
  servicoId             String
  servico               Servico   @relation(fields: [servicoId], references: [id])
  
  tributacaoISSQN       Int       @default(1)
  tipoRetencaoISS       Int       @default(1)
  
  // === TDec_0302_04 ===
  aliquotaISS           Decimal   @db.Decimal(5, 2)
  valorISS              Decimal   @db.Decimal(15, 4)
  
  aliquotaPIS           Decimal?  @db.Decimal(7, 4)
  valorPIS              Decimal?  @db.Decimal(15, 4)
  retidoPIS             Boolean   @default(false)
  aliquotaCOFINS        Decimal?  @db.Decimal(7, 4)
  valorCOFINS           Decimal?  @db.Decimal(15, 4)
  retidoCOFINS          Boolean   @default(false)
  aliquotaIRRF          Decimal?  @db.Decimal(5, 2)
  valorIRRF             Decimal?  @db.Decimal(15, 4)
  aliquotaCSLL          Decimal?  @db.Decimal(5, 2)
  valorCSLL             Decimal?  @db.Decimal(15, 4)
  aliquotaINSS          Decimal?  @db.Decimal(5, 2)
  valorINSS             Decimal?  @db.Decimal(15, 4)
  
  aliquotaIBSUF         Decimal   @db.Decimal(7, 4) @default(0.05)
  valorIBSUF            Decimal   @db.Decimal(15, 4) @default(0)
  aliquotaIBSMun        Decimal   @db.Decimal(7, 4) @default(0.05)
  valorIBSMun           Decimal   @db.Decimal(15, 4) @default(0)
  aliquotaCBS           Decimal   @db.Decimal(7, 4) @default(0.90)
  valorCBS              Decimal   @db.Decimal(15, 4) @default(0)
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("nfses")
}

// ============================================
// NFe - CORRIGIDA COM TIPOS DECIMAIS
// ============================================

model NFe {
  id                    String    @id @default(cuid())
  
  // === TMod (55) ===
  modelo                String    @default("55") @db.Char(2)
  
  // === TSerie ===
  serie                 Int
  
  // === TNF (1-999999999) ===
  numero                Int
  
  // === TChNFe (44 dígitos) ===
  chaveAcesso           String    @unique @db.Char(44)
  
  // === TData e TTime ===
  dataHoraEmissao       DateTime
  dataHoraSaida         DateTime?
  
  // === TString ===
  naturezaOperacao      String
  
  // === TAmb ===
  ambiente              TipoAmbiente @default(PRODUCAO)
  
  // === TpEmis (1-9) ===
  tipoEmissao           Int       @default(1)
  
  // === TpNF (0=Entrada, 1=Saída) ===
  tipoDocumento         Int       @default(1)
  
  // === Finalidade (1=Normal, 2=Complementar, 3=Ajuste) ===
  finalidade            Int       @default(1)
  
  // === Consumidor Final (0=Não, 1=Sim) ===
  consumidorFinal       Boolean   @default(false)
  
  // === IndPresenca (0-5, 9) ===
  presencaComprador     Int       @default(2)
  
  status                StatusDocumento @default(PROCESSANDO)
  
  // === IdDest (1-3) ===
  idDest                Int       @default(1)
  
  // === TpImp (1-3) ===
  tpImp                 Int       @default(1)
  
  // ===== TDec_1104v (15 dígitos, até 4 decimais) =====
  valorTotalProdutos    Decimal   @db.Decimal(15, 4)
  valorTotalFrete       Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalSeguro      Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalDesconto    Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalOutrasDesp  Decimal   @db.Decimal(15, 4) @default(0)
  baseCalculoICMS       Decimal   @db.Decimal(15, 4)
  valorTotalICMS        Decimal   @db.Decimal(15, 4)
  baseCalculoICMSST     Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalICMSST      Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalIPI         Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalPIS         Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalCOFINS      Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalIBS         Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalCBS         Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalTributosAprox Decimal @db.Decimal(15, 4) @default(0)
  valorTotalNota        Decimal   @db.Decimal(15, 4)
  
  // === Forma Pagamento (01-99) ===
  formaPagamento        String    @default("17") @db.Char(2)
  
  // === TString ===
  informacoesAdicionais String?
  
  // === TProt (15 ou 17 dígitos) ===
  protocoloAutorizacao  String?   @db.Char(17)
  dataHoraAutorizacao   DateTime?
  
  // === TJust (15-255 caracteres) ===
  motivoCancelamento    String?
  dataHoraCancelamento  DateTime?
  
  xmlAssinado           String    @db.Text
  
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  
  destinatarioId        String
  destinatario          Cliente   @relation("NFeDestinatario", fields: [destinatarioId], references: [id])
  
  itens                 ItemNFe[]
  duplicatas            Duplicata[]
  transporte            TransporteNFe?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("nfes")
}

// ============================================
// ItemNFe - CORRIGIDO COM TIPOS DECIMAIS
// ============================================

model ItemNFe {
  id                    String    @id @default(cuid())
  codigoProduto         String
  descricao             String
  ncm                   String    @db.Char(8)
  cest                  String?   @db.Char(7)
  cfop                  String    @db.Char(4)
  unidadeMedida         String    @default("UN")
  
  // === TDec_1104v (15 dígitos, até 4 decimais) ===
  quantidade            Decimal   @db.Decimal(15, 4)
  valorUnitario         Decimal   @db.Decimal(15, 4)
  valorTotalBruto       Decimal   @db.Decimal(15, 4)
  descontoItem          Decimal   @db.Decimal(15, 4) @default(0)
  
  origemMercadoria      Int       @default(0)
  
  // === CST ICMS (00-99) ===
  cstICMS               String    @default("00") @db.Char(2)
  
  // === TDec_0302_04 ===
  aliquotaICMS          Decimal   @db.Decimal(5, 2)
  baseCalculoICMS       Decimal   @db.Decimal(15, 4)
  valorICMS             Decimal   @db.Decimal(15, 4)
  
  cstIPI                String?   @db.Char(2)
  aliquotaIPI           Decimal?  @db.Decimal(5, 2)
  valorIPI              Decimal?  @db.Decimal(15, 4)
  
  cstPIS                String    @default("01") @db.Char(2)
  aliquotaPIS           Decimal   @db.Decimal(7, 4)
  valorPIS              Decimal   @db.Decimal(15, 4)
  
  cstCOFINS             String    @default("01") @db.Char(2)
  aliquotaCOFINS        Decimal   @db.Decimal(7, 4)
  valorCOFINS           Decimal   @db.Decimal(15, 4)
  
  aliquotaIBSUF         Decimal?  @db.Decimal(7, 4)
  valorIBSUF            Decimal?  @db.Decimal(15, 4)
  aliquotaIBSMun        Decimal?  @db.Decimal(7, 4)
  valorIBSMun           Decimal?  @db.Decimal(15, 4)
  aliquotaCBS           Decimal?  @db.Decimal(7, 4)
  valorCBS              Decimal?  @db.Decimal(15, 4)
  
  valorTributosAprox    Decimal   @db.Decimal(15, 4) @default(0)
  
  nfeId                 String
  nfe                   NFe       @relation(fields: [nfeId], references: [id])
  
  // === GTIN (8, 12, 13, 14 dígitos) ===
  codigoEAN             String?
  codigoEANTrib         String?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("itens_nfe")
}

model Duplicata {
  id                    String    @id @default(cuid())
  numero                String
  dataVencimento        DateTime
  valor                 Decimal   @db.Decimal(15, 4)
  status                String    @default("PENDENTE")
  
  nfeId                 String
  nfe                   NFe       @relation(fields: [nfeId], references: [id])
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("duplicatas")
}

model TransporteNFe {
  id                    String    @id @default(cuid())
  
  // === Modalidade Frete (0-9) ===
  modalidadeFrete       Int       @default(0)
  
  transportadoraId      String?
  transportadora        Transportadora? @relation(fields: [transportadoraId], references: [id])
  
  // === TCnpjOpc (vazio ou 14 dígitos) ===
  transportadoraCnpj    String?   @db.Char(14)
  transportadoraNome    String?
  transportadoraIE      String?
  transportadoraEndereco String?
  transportadoraMunicipio String?
  transportadoraUf      String?   @db.Char(2)
  
  // === Placa (7 caracteres) ===
  veiculoPlaca          String?   @db.Char(7)
  veiculoUf             String?   @db.Char(2)
  veiculoRNTC           String?
  
  // === TDec_1104v ===
  volumesQuantidade     Decimal?  @db.Decimal(15, 4)
  volumesEspecie        String?
  volumesMarca          String?
  volumesPesoLiquido    Decimal?  @db.Decimal(15, 4)
  volumesPesoBruto      Decimal?  @db.Decimal(15, 4)
  
  nfeId                 String    @unique
  nfe                   NFe       @relation(fields: [nfeId], references: [id])
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  
  @@map("transportes_nfe")
  @@index([transportadoraId])
}

// ============================================
// NFCe - CORRIGIDA
// ============================================

model NFCe {
  id                    String    @id @default(cuid())
  
  // === TMod (65) ===
  modelo                String    @default("65") @db.Char(2)
  
  // === TSerie ===
  serie                 Int
  
  // === TNF ===
  numero                Int
  
  // === TChNFe (44 dígitos) ===
  chaveAcesso           String    @unique @db.Char(44)
  
  dataHoraEmissao       DateTime
