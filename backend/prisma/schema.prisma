generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// ENUMS
// ============================================

enum TipoPessoa {
  PF
  PJ
  EXTERIOR
}

enum TipoCliente {
  CLIENTE
  FORNECEDOR
  AMBOS
}

enum StatusDocumento {
  RASCUNHO
  VALIDADA
  ASSINADA
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  DENEGADA
  SUBSTITUIDA
}

enum TipoAmbiente {
  PRODUCAO
  HOMOLOGACAO
}

enum StatusTitulo {
  PENDENTE
  PAGO
  VENCIDO
  CANCELADO
}

enum TipoTitulo {
  RECEBER
  PAGAR
}

enum CategoriaFinanceira {
  VENDA_PRODUTOS
  PRESTACAO_SERVICOS
  COMPRA_MERCADORIAS
  FOLHA_PAGAMENTO
  IMPOSTOS_TRIBUTOS
  ALUGUEL_INFRA
  MARKETING_VENDAS
  DESPESAS_ADMINISTRATIVAS
  OUTRAS_RECEITAS
  OUTRAS_DESPESAS
}

enum RegimeTributario {
  SIMPLES_NACIONAL
  SIMPLES_EXCESSO
  NORMAL
}

enum TipoMovimentacaoEstoque {
  ENTRADA_COMPRA
  SAIDA_VENDA
  SAIDA_NFE
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
  INVENTARIO
}

enum PerfilUsuario {
  ADMIN
  FISCAL
  OPERADOR
}

// ============================================
// TABELAS PRINCIPAIS
// ============================================

model Empresa {
  id                    String    @id @default(cuid())
  razaoSocial           String
  nomeFantasia          String?
  cnpj                  String    @unique @db.Char(14)
  inscricaoEstadual     String?
  inscricaoEstadualST   String?
  inscricaoMunicipal    String?
  cnae                  String?
  regimeTributario      RegimeTributario @default(SIMPLES_NACIONAL)
  aliquotaSimples       Decimal?  @db.Decimal(5, 2) @default(6.00)
  ambienteEmissao       TipoAmbiente @default(PRODUCAO)

  // === DADOS DA UF E MUNICÍPIO ===
  uf                    String    @db.Char(2)
  codigoUF              String    @db.Char(2)
  codigoMunicipio       String    @db.Char(7)
  nomeMunicipio         String

  // === TIPO DE EMISSÃO (MANUAL - SEÇÃO III) ===
  tipoEmissao           String    @default("1") @db.Char(1)   // 1=Normal, 2=Contingência FS, 3=Regime Especial, 4=DPEC, 5=FSDA, 6=SVC-AN, 7=SVC-RS, 9=Off-line
  justificativaContingencia String? @db.VarChar(256)

  // === NUMERAÇÃO POR SÉRIE ===
  serieNfe              Int       @default(1)
  proximoNumeroNfe      Int       @default(1)
  serieNfeAno           Int       @default(0)
  proximoNumeroNfeAno   Int       @default(1)
  serieNfse             Int       @default(1)
  proximoNumeroNfse     Int       @default(1)
  serieNfce             Int       @default(1)
  proximoNumeroNfce     Int       @default(1)
  serieCte              Int       @default(1)
  proximoNumeroCte      Int       @default(1)
  serieNfae             Int       @default(900)
  proximoNumeroNfae     Int       @default(1)

  // === CONFIGURAÇÕES DE PAGAMENTO ===
  chavePixPadrao        String?
  bancoPadrao           String?

  // === CONFIGURAÇÕES DE TRIBUTAÇÃO ===
  optanteSimples        Boolean   @default(true)
  optanteMEI            Boolean   @default(false)

  // === TOKEN CSC (NFCe) ===
  tokenCSC              String?   @db.VarChar(36)
  tokenCSCId            String?   @db.VarChar(2)

  // === CONFIGURAÇÕES DE AMBIENTE SEFAZ ===
  homologacaoWebService String?   @db.Text
  producaoWebService    String?   @db.Text
  homologacaoQrCode     String?   @db.Text
  producaoQrCode        String?   @db.Text

  // === NUMERAÇÃO MDF-e ===
  serieMdfe              Int       @default(1)
  proximoNumeroMdfe      Int       @default(1)
  serieMdfeAno           Int       @default(0)
  proximoNumeroMdfeAno   Int       @default(1)
  
  // === RELACIONAMENTOS MDF-e ===
  mdfes                  MDFe[]
  lotesMDFe              LoteMDFe[]
  
  // === RELACIONAMENTOS ===
  enderecoId            String    @unique
  endereco              Endereco  @relation(fields: [enderecoId], references: [id])
  certificadoId         String?   @unique
  certificado           CertificadoDigital? @relation(fields: [certificadoId], references: [id])

  usuarios              Usuario[]
  clientes              Cliente[]
  produtos              Produto[]
  servicos              Servico[]
  nfses                 NFSe[]
  nfes                  NFe[]
  nfces                 NFCe[]
  ctes                  CTe[]
  nfaes                 NFAe[]
  titulos               TituloFinanceiro[]
  movimentacoes         MovimentacaoEstoque[]
  transportadoras       Transportadora[]
  eventosNFe            EventoNFe[]
  eventosCreditoPresumido EventoCreditoPresumido[]
  inutilizacoes         InutilizacaoNFe[]
  lotes                 LoteNFe[]
  envios                EnvioNFe[]
  agendamentos          AgendamentoBusca[]
  configuracaoAmbiente  ConfiguracaoAmbiente?
  parametros            ParametroSistema?
  historicoBackup       HistoricoBackup[]
  logs                  LogAcao[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("empresas")
}

model Endereco {
  id                String    @id @default(cuid())
  logradouro        String
  numero            String
  complemento       String?
  bairro            String
  codigoMunicipio   String    @db.Char(7)
  nomeMunicipio     String
  uf                String    @db.Char(2)
  codigoUF          String    @db.Char(2)
  cep               String    @db.Char(9)
  telefone          String?
  email             String?
  codigoPais        String?   @default("1058") @db.Char(4)
  nomePais          String?   @default("BRASIL")
  empresa           Empresa?
  cliente           Cliente?
  transportadora    Transportadora?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("enderecos")
}

model CertificadoDigital {
  id                    String    @id @default(cuid())
  tipo                  String    @default("A1")
  nomeTitular           String
  cnpjCpf               String
  emissora              String
  dataValidadeInicio    DateTime
  dataValidadeFim       DateTime
  diasRestantes         Int
  arquivoCarregadoNome  String?
  status                String    @default("VALIDO")
  arquivoBase64         String?   @db.Text
  senha                 String?   @db.Text
  empresa               Empresa?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("certificados_digitais")
}

model Usuario {
  id                String    @id @default(cuid())
  nome              String
  email             String    @unique
  senhaHash         String    @db.Text
  cargo             String?
  perfil            PerfilUsuario @default(OPERADOR)
  ativo             Boolean   @default(true)
  ultimoLogin       DateTime?
  empresaId         String
  empresa           Empresa   @relation(fields: [empresaId], references: [id])
  logs              LogAcao[]
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("usuarios")
}

// ============================================
// LOG DE AÇÕES (RASTREABILIDADE)
// ============================================

model LogAcao {
  id                    String    @id @default(cuid())
  usuarioId             String
  usuario               Usuario   @relation(fields: [usuarioId], references: [id])
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  acao                  String                                // ASSINAR, TRANSMITIR, CANCELAR, INUTILIZAR, IMPRIMIR, VALIDAR, EXPORTAR, IMPORTAR, EXCLUIR
  entidade              String                                // NFe, NFCe, CTe, NFSe, Cliente, Produto, Transportadora
  entidadeId            String
  dadosAntigos          String?   @db.Json
  dadosNovos            String?   @db.Json
  ipOrigem              String?   @db.VarChar(45)
  dataHora              DateTime  @default(now())

  @@map("logs_acao")
  @@index([empresaId])
  @@index([entidade, entidadeId])
}

// ============================================
// SCHEMA VERSION (CONTROLE DE VERSÃO)
// ============================================

model SchemaVersion {
  id                    String    @id @default(cuid())
  versao                String                                // "4.0.0"
  dataAtualizacao       DateTime  @default(now())
  descricao             String

  @@map("schema_version")
}

// ============================================
// CLIENTE / DESTINATÁRIO (MANUAL - VI)
// ============================================

model Cliente {
  id                    String    @id @default(cuid())
  tipo                  TipoCliente @default(CLIENTE)
  tipoPessoa            TipoPessoa @default(PJ)
  documento             String    @unique
  razaoSocial           String
  nomeFantasia          String?
  inscricaoEstadual     String?
  inscricaoEstadualST   String?
  inscricaoMunicipal    String?
  inscricaoSuframa      String?   @db.Char(9)

  // === INDICADOR IE (MANUAL - SEÇÃO VI) ===
  indIEDest             String    @default("9") @db.Char(1)   // 1=Contribuinte ICMS, 2=Isento, 9=Não contribuinte

  email                 String?
  telefone              String?
  celularWhatsApp       String?
  contato               String?
  observacoes           String?
  ativo                 Boolean   @default(true)

  enderecoId            String    @unique
  endereco              Endereco  @relation(fields: [enderecoId], references: [id])

  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  titulos               TituloFinanceiro[]
  nfsesTomador          NFSe[]    @relation("NFSeTomador")
  nfesDestinatario      NFe[]     @relation("NFeDestinatario")
  nfcesConsumidor       NFCe[]    @relation("NFCeConsumidor")
  cteRemetente          CTe[]     @relation("CTeRemetente")
  cteDestinatario       CTe[]     @relation("CTeDestinatario")
  nfaesDestinatario     NFAe[]    @relation("NFAeDestinatario")
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  // === MDF-e ===
  mdfesEmitente          MDFe[]    @relation("MDFeEmitente")

  @@map("clientes")
}

// ============================================
// PRODUTO
// ============================================

model Produto {
  id                    String    @id @default(cuid())
  codigo                String    @unique
  codigoBarrasEAN       String?
  descricao             String
  categoria             String
  unidade               String    @default("UN")
  uTrib                 String?   @db.VarChar(6)              // Unidade tributável (MANUAL V.1)
  ncm                   String    @db.Char(8)
  cest                  String?   @db.Char(7)
  cfopPadrao            String    @default("5102") @db.Char(4)
  origem                String    @default("0") @db.Char(1)

  precoCusto            Decimal   @db.Decimal(15, 4) @default(0)
  margemLucro           Decimal   @db.Decimal(5, 2) @default(0)
  precoVenda            Decimal   @db.Decimal(15, 4) @default(0)

  estoqueAtual          Decimal   @db.Decimal(11, 3) @default(0)
  estoqueMinimo         Decimal   @db.Decimal(11, 3) @default(0)
  estoqueMaximo         Decimal?  @db.Decimal(11, 3)

  aliquotaICMS          Decimal   @db.Decimal(5, 2) @default(18.00)
  aliquotaICMSST        Decimal?  @db.Decimal(5, 2)
  aliquotaPIS           Decimal   @db.Decimal(7, 4) @default(1.65)
  aliquotaCOFINS        Decimal   @db.Decimal(7, 4) @default(7.60)
  aliquotaIPI           Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaIBS           Decimal   @db.Decimal(7, 4) @default(0.10)
  aliquotaCBS           Decimal   @db.Decimal(7, 4) @default(0.90)

  cstICMS               String    @default("00") @db.Char(2)
  csosnICMS             String?   @db.Char(3)
  cstPIS                String    @default("01") @db.Char(2)
  cstCOFINS             String    @default("01") @db.Char(2)
  cstIPI                String?   @db.Char(2)

  modBC                 String    @default("3") @db.Char(1)
  modBCST               String    @default("4") @db.Char(1)
  pRedBC                Decimal?  @db.Decimal(5, 2)
  pMVAST                Decimal?  @db.Decimal(5, 2)
  pRedBCST              Decimal?  @db.Decimal(5, 2)

  ativo                 Boolean   @default(true)

  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  movimentacoes         MovimentacaoEstoque[]
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("produtos")
}

model Servico {
  id                          String    @id @default(cuid())
  codigoInterno               String    @unique
  descricao                   String
  codigoTributacaoNacional    String    @db.Char(6)
  codigoTributacaoMunicipal   String?   @db.Char(4)
  codigoNBS                   String?
  cListServ                   String    @db.Char(5)
  valorUnitario               Decimal   @db.Decimal(15, 4) @default(0)
  aliquotaISS                 Decimal   @db.Decimal(5, 2) @default(5.00)
  retencaoISSPadrao           Boolean   @default(false)
  aliquotaPIS                 Decimal   @db.Decimal(7, 4) @default(0.65)
  aliquotaCOFINS              Decimal   @db.Decimal(7, 4) @default(3.00)
  aliquotaIRRF                Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaCSLL                Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaINSS                Decimal   @db.Decimal(5, 2) @default(0)
  aliquotaIBS                 Decimal   @db.Decimal(7, 4) @default(0.10)
  aliquotaCBS                 Decimal   @db.Decimal(7, 4) @default(0.90)
  ativo                       Boolean   @default(true)
  empresaId                   String
  empresa                     Empresa   @relation(fields: [empresaId], references: [id])
  nfses                       NFSe[]
  createdAt                   DateTime  @default(now())
  updatedAt                   DateTime  @updatedAt

  @@map("servicos")
}

// ============================================
// NFSe
// ============================================

model NFSe {
  id                    String    @id @default(cuid())
  chaveAcesso           String    @unique @db.Char(53)
  numeroNfse            Int
  serieDPS              Int       @default(1)
  numeroDPS             Int
  dataCompetencia       DateTime
  dataHoraEmissao       DateTime
  dataHoraProcessamento DateTime
  codigoVerificacao     String    @db.Char(9)
  ambiente              TipoAmbiente @default(PRODUCAO)
  tipoEmissao           String    @default("1") @db.Char(1)
  status                StatusDocumento @default(PROCESSANDO)
  valorTotalServicos    Decimal   @db.Decimal(15, 4)
  valorTotalDescontos   Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalDeducoes    Decimal   @db.Decimal(15, 4) @default(0)
  baseCalculoISS        Decimal   @db.Decimal(15, 4)
  valorTotalISS         Decimal   @db.Decimal(15, 4)
  valorTotalISSRetido   Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalRetencoesFed Decimal  @db.Decimal(15, 4) @default(0)
  valorTotalIBS         Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalCBS         Decimal   @db.Decimal(15, 4) @default(0)
  valorLiquidoNfse      Decimal   @db.Decimal(15, 4)
  valorTotalNotaFinal   Decimal   @db.Decimal(15, 4)
  indISS                String    @default("1") @db.Char(1)
  indIncentivo          String    @default("2") @db.Char(1)
  informacoesComplementares String?
  numeroPedido          String?
  motivoCancelamento    String?
  dataHoraCancelamento  DateTime?
  chaveNfseSubstituta   String?
  xmlAssinado           String    @db.Text
  urlVisualizacao       String?
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  tomadorId             String
  tomador               Cliente   @relation("NFSeTomador", fields: [tomadorId], references: [id])
  servicoId             String
  servico               Servico   @relation(fields: [servicoId], references: [id])
  tributacaoISSQN       String    @default("1") @db.Char(1)
  tipoRetencaoISS       String    @default("1") @db.Char(1)
  aliquotaISS           Decimal   @db.Decimal(5, 2)
  valorISS              Decimal   @db.Decimal(15, 4)
  aliquotaPIS           Decimal?  @db.Decimal(7, 4)
  valorPIS              Decimal?  @db.Decimal(15, 4)
  retidoPIS             Boolean   @default(false)
  aliquotaCOFINS        Decimal?  @db.Decimal(7, 4)
  valorCOFINS           Decimal?  @db.Decimal(15, 4)
  retidoCOFINS          Boolean   @default(false)
  aliquotaIRRF          Decimal?  @db.Decimal(5, 2)
  valorIRRF             Decimal?  @db.Decimal(15, 4)
  aliquotaCSLL          Decimal?  @db.Decimal(5, 2)
  valorCSLL             Decimal?  @db.Decimal(15, 4)
  aliquotaINSS          Decimal?  @db.Decimal(5, 2)
  valorINSS             Decimal?  @db.Decimal(15, 4)
  aliquotaIBSUF         Decimal   @db.Decimal(7, 4) @default(0.05)
  valorIBSUF            Decimal   @db.Decimal(15, 4) @default(0)
  aliquotaIBSMun        Decimal   @db.Decimal(7, 4) @default(0.05)
  valorIBSMun           Decimal   @db.Decimal(15, 4) @default(0)
  aliquotaCBS           Decimal   @db.Decimal(7, 4) @default(0.90)
  valorCBS              Decimal   @db.Decimal(15, 4) @default(0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("nfses")
}

// ============================================
// NFe - NOTA FISCAL ELETRÔNICA (LEIAUTE 4.00)
// ============================================

model NFe {
  id                    String    @id @default(cuid())

  // === IDENTIFICAÇÃO (MANUAL - SEÇÃO IV E V) ===
  modelo                String    @default("55") @db.Char(2)
  serie                 Int
  numero                Int
  chaveAcesso           String    @unique @db.Char(44)
  cUF                   String    @db.Char(2)
  cNF                   String    @db.Char(8)
  natOp                 String    @db.VarChar(60)
  indPag                String    @db.Char(1)
  mod                   String    @default("55") @db.Char(2)
  dhEmi                 DateTime
  dhSaiEnt              DateTime?
  tpNF                  String    @db.Char(1)
  idDest                String    @db.Char(1)
  cMunFG                String    @db.Char(7)
  tpImp                 String    @db.Char(1)
  tpEmis                String    @db.Char(1)
  cDV                   String    @db.Char(1)
  tpAmb                 String    @db.Char(1)
  finNFe                String    @db.Char(1)
  indFinal              String    @db.Char(1)
  indPres               String    @db.Char(1)
  procEmi               String    @db.Char(1)
  verProc               String    @db.VarChar(20)

  // === CONTINGÊNCIA (MANUAL - IV.5) ===
  dhCont                DateTime?
  xJust                 String?   @db.VarChar(256)

  // === STATUS ===
  status                StatusDocumento @default(PROCESSANDO)
  versaoNFe             String    @default("4.00") @db.VarChar(5)

  // === VALORES TOTAIS - LEIAUTE 4.00 ===
  vBC                   Decimal   @db.Decimal(15, 4)          // Base de cálculo ICMS
  vICMS                 Decimal   @db.Decimal(15, 4)          // Valor ICMS
  vICMSDeson            Decimal   @db.Decimal(15, 4) @default(0)
  vFCP                  Decimal   @db.Decimal(15, 4) @default(0)
  vBCST                 Decimal   @db.Decimal(15, 4) @default(0) // Base de cálculo ICMS ST
  vST                   Decimal   @db.Decimal(15, 4) @default(0) // Valor ICMS ST
  vFCPST                Decimal   @db.Decimal(15, 4) @default(0)
  vFCPSTRet             Decimal   @db.Decimal(15, 4) @default(0)
  vProd                 Decimal   @db.Decimal(15, 4)          // Valor total dos produtos
  vFrete                Decimal   @db.Decimal(15, 4) @default(0) // Valor do frete
  vSeg                  Decimal   @db.Decimal(15, 4) @default(0) // Valor do seguro
  vDesc                 Decimal   @db.Decimal(15, 4) @default(0) // Valor do desconto
  vII                   Decimal   @db.Decimal(15, 4) @default(0) // Valor do II
  vIPI                  Decimal   @db.Decimal(15, 4) @default(0) // Valor do IPI
  vIPIDevol             Decimal   @db.Decimal(15, 4) @default(0) // Valor IPI devolução
  vPIS                  Decimal   @db.Decimal(15, 4) @default(0) // Valor do PIS
  vCOFINS               Decimal   @db.Decimal(15, 4) @default(0) // Valor do COFINS
  vOutro                Decimal   @db.Decimal(15, 4) @default(0) // Outras despesas
  vNF                   Decimal   @db.Decimal(15, 4)          // Valor total da NF-e
  vTotTrib              Decimal   @db.Decimal(15, 4) @default(0) // Total tributos aproximado

  // === ICMS UF DESTINO ===
  vFCPUFDest            Decimal   @db.Decimal(15, 4) @default(0)
  vICMSUFDest           Decimal   @db.Decimal(15, 4) @default(0)
  vICMSUFRemet          Decimal   @db.Decimal(15, 4) @default(0)

  // === ICMS MONOFÁSICO ===
  qBCMono               Decimal?  @db.Decimal(15, 4)
  vICMSMono             Decimal?  @db.Decimal(15, 4)
  qBCMonoReten          Decimal?  @db.Decimal(15, 4)
  vICMSMonoReten        Decimal?  @db.Decimal(15, 4)
  qBCMonoRet            Decimal?  @db.Decimal(15, 4)
  vICMSMonoRet          Decimal?  @db.Decimal(15, 4)

  // === IBS/CBS ===
  vIBS                  Decimal   @db.Decimal(15, 4) @default(0)
  vCBS                  Decimal   @db.Decimal(15, 4) @default(0)

  // === INFORMAÇÕES ADICIONAIS ===
  infAdFisco            String?   @db.VarChar(2000)
  infCpl                String?   @db.VarChar(5000)

  // === CONTROLE DE IMPRESSÃO DANFE (MANUAL - V.7) ===
  danfeImpresso         Boolean   @default(false)
  dataHoraImpressao     DateTime?
  usuarioImpressao      String?

  // === PROTOCOLOS ===
  protocoloAutorizacao  String?   @db.Char(17)
  dataHoraAutorizacao   DateTime?
  motivoCancelamento    String?
  dataHoraCancelamento  DateTime?
  motivoRejeicao        String?   @db.VarChar(500)
  dataHoraRejeicao      DateTime?

  // === XMLs ===
  xmlAssinado           String    @db.Text
  xmlRetorno            String?   @db.Text

  // === CONTROLE DE ENVIO ===
  enviadoEm             DateTime?
  enviadoPor            String?
  ipEnvio               String?   @db.VarChar(45)
  reciboLote            String?   @db.VarChar(15)

  // === RELACIONAMENTOS ===
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  destinatarioId        String
  destinatario          Cliente   @relation("NFeDestinatario", fields: [destinatarioId], references: [id])
  loteId                String?
  lote                  LoteNFe?  @relation("LoteNFe", fields: [loteId], references: [id])

  itens                 ItemNFe[]
  duplicatas            Duplicata[]
  transporte            TransporteNFe?
  pagamentos            PagamentoNFe[]
  referencias           NFeReferencia[]
  eventos               EventoNFe[]
  intermediador         Intermediador?
  exportacao            Exportacao?
  compra                Compra?
  cana                  Cana?
  responsavelTecnico    ResponsavelTecnico?
  processos             ProcessoReferenciado[]
  danfes                Danfe[]
  envios                EnvioNFe[]
  inutilizacao          InutilizacaoNFe?
  historicoStatus       HistoricoStatusNFe[]

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("nfes")
}

