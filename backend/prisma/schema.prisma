  // === TDec_1104v ===
  valorTotalProdutos    Decimal   @db.Decimal(15, 4)
  valorTotalDesconto    Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalAcrescimo   Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalTributosAprox Decimal @db.Decimal(15, 4) @default(0)
