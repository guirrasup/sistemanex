// ============================================
// MDF-e - MANIFESTO DE DOCUMENTOS FISCAIS ELETRÔNICOS
// ============================================

enum StatusMDFe {
  RASCUNHO
  VALIDADA
  ASSINADA
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  DENEGADA
  ENCERRADA
}

enum ModalMDFe {
  RODOVIARIO   // 1
  AEREO        // 2
  AQUAVIARIO   // 3
  FERROVIARIO  // 4
}

enum TipoEmitenteMDFe {
  PRESTADOR_SERVICO        // 1
  TRANSPORTADOR_CARGA_PROPRIA // 2
  CTE_GLOBALIZADO          // 3
}

enum TipoTransportadorMDFe {
  ETC  // 1
  TAC  // 2
  CTC  // 3
}

enum TipoCargaMDFe {
  GRANEL_SOLIDO           // 01
  GRANEL_LIQUIDO          // 02
  FRIGORIFICADA           // 03
  CONTEINERIZADA          // 04
  CARGA_GERAL             // 05
  NEOGRANEL               // 06
  PERIGOSA_GRANEL_SOLIDO  // 07
  PERIGOSA_GRANEL_LIQUIDO // 08
  PERIGOSA_FRIGORIFICADA  // 09
  PERIGOSA_CONTEINERIZADA // 10
  PERIGOSA_CARGA_GERAL    // 11
  GRANEL_PRESSURIZADA     // 12
}

model MDFe {
  id                    String    @id @default(cuid())
  
  // === IDENTIFICAÇÃO (ide) ===
  chaveAcesso           String    @unique @db.Char(44)
  modelo                String    @default("58") @db.Char(2)
  serie                 Int
  numero                Int
  cUF                   String    @db.Char(2)
  cMDF                  String    @db.Char(8)   // Código aleatório (8 dígitos)
  cDV                   String    @db.Char(1)
  modal                 ModalMDFe
  tpAmb                 String    @default("1") @db.Char(1) // 1=Produção, 2=Homologação
  tpEmit                TipoEmitenteMDFe
  tpTransp              TipoTransportadorMDFe?
  tpEmis                String    @default("1") @db.Char(1) // 1=Normal, 2=Contingência, 3=Regime Especial
  procEmi               String    @default("0") @db.Char(1) // 0=Aplicativo, 4=PAA
  verProc               String    @db.VarChar(20)
  dhEmi                 DateTime
  dhIniViagem           DateTime?
  UFIni                 String    @db.Char(2)
  UFFim                 String    @db.Char(2)
  indCanalVerde         Boolean?  @default(false)
  indCarregaPosterior   Boolean?  @default(false)
  
  // === STATUS ===
  status                StatusMDFe @default(RASCUNHO)
  versaoMDFe            String    @default("3.00") @db.VarChar(5)
  
  // === VALORES TOTAIS ===
  qCTe                  Int?      @default(0)
  qNFe                  Int?      @default(0)
  qMDFe                 Int?      @default(0)  // Para modal Aquaviário
  vCarga                Decimal   @db.Decimal(15, 4)
  cUnid                 String    @db.Char(2)  // 01=KG, 02=TON
  qCarga                Decimal   @db.Decimal(15, 4)
  
  // === PRODUTO PREDOMINANTE ===
  tpCarga               TipoCargaMDFe
  xProd                 String    @db.VarChar(120)
  cEAN                  String?   @db.VarChar(14)
  NCM                   String?   @db.Char(8)
  
  // === INFORMAÇÕES ADICIONAIS ===
  infAdFisco            String?   @db.VarChar(2000)
  infCpl                String?   @db.VarChar(5000)
  
  // === PROTOCOLOS ===
  protocoloAutorizacao  String?   @db.Char(17)
  dataHoraAutorizacao   DateTime?
  motivoCancelamento    String?
  dataHoraCancelamento  DateTime?
  motivoRejeicao        String?   @db.VarChar(500)
  dataHoraRejeicao      DateTime?
  motivoEncerramento    String?   @db.VarChar(255)
  dataHoraEncerramento  DateTime?
  
  // === XMLs ===
  xmlAssinado           String    @db.Text
  xmlRetorno            String?   @db.Text
  xmlModal              String?   @db.Text  // XML específico do modal (rodoviário, aéreo, etc)
  
  // === CONTROLE ===
  enviadoEm             DateTime?
  enviadoPor            String?
  ipEnvio               String?   @db.VarChar(45)
  
  // === RELACIONAMENTOS ===
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  emitenteId            String?
  emitente              Cliente?  @relation("MDFeEmitente", fields: [emitenteId], references: [id])
  
  // === SUB-ESTRUTURAS ===
  municipiosCarrega     MunCarregaMDFe[]
  percursos             PercursoMDFe[]
  municipiosDescarga    MunDescargaMDFe[]
  seguros               SeguroMDFe[]
  lacres                LacreMDFe[]
  autorizadosDownload   AutXMLMDFe[]
  historicoStatus       HistoricoStatusMDFe[]
  encerramento          EncerramentoMDFe?
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("mdfes")
  @@index([empresaId])
  @@index([chaveAcesso])
  @@index([status])
  @@index([modal])
}

