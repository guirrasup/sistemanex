// ============================================
// NFCe - NOTA FISCAL DE CONSUMIDOR ELETRÔNICA
// LEIAUTE 4.00 - COMPLETO
// ============================================

model NFCe {
  id                    String    @id @default(cuid())
  
  // === IDENTIFICAÇÃO (ide) ===
  modelo                String    @default("65") @db.Char(2)
  serie                 Int
  numero                Int
  chaveAcesso           String    @unique @db.Char(44)
  dataHoraEmissao       DateTime
  
  // === DADOS DA OPERAÇÃO ===
  naturezaOperacao      String    @default("Venda a Consumidor Final") @db.VarChar(60)
  tpNF                  Int       @default(1)           // 0=Entrada, 1=Saída
  idDest                Int       @default(1)           // 1=Interna, 2=Interestadual, 3=Exterior
  finNFe                Int       @default(1)           // 1=Normal, 2=Complementar, 3=Ajuste, 4=Devolução
  indFinal              Int       @default(1)           // 0=Não consumidor final, 1=Consumidor final
  indPres               Int       @default(2)           // 0=Não se aplica, 1=Presencial, 2=Não presencial, 3=Internet, 4=Teleatendimento, 5=NFC-e entrega, 9=Presencial fora
  
  // === AMBIENTE E EMISSÃO ===
  ambiente              TipoAmbiente @default(PRODUCAO)
  tipoEmissao           String    @default("1") @db.Char(1)  // 1=Normal, 2=Contingência, 3=Regime Especial, 4=SCAN, 5=SVC, 6=SVC_RS, 7=SVC_PR, 9=Off-line
  procEmi               String    @default("0") @db.Char(1)  // 0=Aplicativo contribuinte, 1=Avulsa, 2=Avulsa Fisco, 4=PAA
  verProc               String    @default("SUP-TECNOLOGIA-4.00") @db.VarChar(20)
  
  // === STATUS ===
  status                StatusDocumento @default(PROCESSANDO)
  
  // === CONSUMIDOR ===
  consumidorIdentificado Boolean  @default(false)
  consumidorCpfCnpj     String?   @db.VarChar(14)
  consumidorNome        String?   @db.VarChar(60)
  consumidorEmail       String?   @db.VarChar(60)
  consumidorTelefone    String?   @db.VarChar(14)
  
  // === ENDEREÇO DO CONSUMIDOR ===
  consumidorLogradouro  String?   @db.VarChar(60)
  consumidorNumero      String?   @db.VarChar(60)
  consumidorComplemento String?   @db.VarChar(60)
  consumidorBairro      String?   @db.VarChar(60)
  consumidorCodigoMunicipio String? @db.Char(7)
  consumidorNomeMunicipio String? @db.VarChar(60)
  consumidorUf          String?   @db.Char(2)
  consumidorCep         String?   @db.Char(9)
  consumidorCodigoPais  String?   @db.Char(4)
  consumidorNomePais    String?   @db.VarChar(60)
  
  // === VALORES TOTAIS ===
  valorTotalProdutos    Decimal   @db.Decimal(15, 4)
  valorTotalDesconto    Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalAcrescimo   Decimal   @db.Decimal(15, 4) @default(0)
  valorTotalTributosAprox Decimal @db.Decimal(15, 4) @default(0)
  valorTotalNota        Decimal   @db.Decimal(15, 4)
  
  // === PAGAMENTO ===
  formaPagamento        String    @default("17") @db.Char(2)
  valorPago             Decimal   @db.Decimal(15, 4)
  valorTroco            Decimal   @db.Decimal(15, 4) @default(0)
  
  // === QR CODE ===
  urlQrCode             String?
  tokenCscId            String?   @db.VarChar(6)
  
  // === INFORMAÇÕES ADICIONAIS ===
  infAdFisco            String?   @db.VarChar(2000)
  infCpl                String?   @db.VarChar(5000)
  
  // === PROTOCOLOS ===
  protocoloAutorizacao  String?   @db.Char(17)
  dataHoraAutorizacao   DateTime?
  motivoCancelamento    String?   @db.VarChar(255)
  dataHoraCancelamento  DateTime?
  motivoRejeicao        String?   @db.VarChar(500)
  dataHoraRejeicao      DateTime?
  
  // === XML ===
  xmlAssinado           String    @db.Text
  xmlRetorno            String?   @db.Text
  
  // === CONTROLE ===
  enviadoEm             DateTime?
  enviadoPor            String?
  ipEnvio               String?   @db.VarChar(45)
  
  // === RELACIONAMENTOS ===
  empresaId             String
  empresa               Empresa   @relation(fields: [empresaId], references: [id])
  consumidorId          String?
  consumidor            Cliente?  @relation("NFCeConsumidor", fields: [consumidorId], references: [id])
  itens                 ItemNFCe[]
  pagamentos            PagamentoNFCe[]
  historicoStatus       HistoricoStatusNFCe[]
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("nfces")
  @@index([empresaId])
  @@index([chaveAcesso])
  @@index([status])
  @@index([consumidorId])
  @@index([dataHoraEmissao])
  @@index([protocoloAutorizacao])
  @@index([numero, serie])
}

// ============================================
// ITEM NFC-e
// ============================================

model ItemNFCe {
  id                    String    @id @default(cuid())
  
  // === IDENTIFICAÇÃO DO PRODUTO ===
  codigoProduto         String
  descricao             String    @db.VarChar(120)
  ncm                   String    @db.Char(8)
  cest                  String?   @db.Char(7)
  cfop                  String    @db.Char(4)
  unidadeMedida         String    @default("UN") @db.VarChar(6)
  quantidade            Decimal   @db.Decimal(15, 4)
  valorUnitario         Decimal   @db.Decimal(15, 4)
  valorTotalBruto       Decimal   @db.Decimal(15, 4)
  
  // === GTIN ===
  codigoEAN             String?   @db.VarChar(14)
  codigoEANTrib         String?   @db.VarChar(14)
  cBarra                String?   @db.VarChar(30)
  cBarraTrib            String?   @db.VarChar(30)
  
  // === ORIGEM ===
  origemMercadoria      Int       @default(0)             // 0=Nacional, 1=Estrangeira, 2=Estrangeira mercado interno
  
  // === ICMS ===
  cstICMS               String    @default("00") @db.Char(2)
  csosnICMS             String?   @db.Char(3)
  modBC                 String?   @default("3") @db.Char(1)
  aliquotaICMS          Decimal   @db.Decimal(5, 2)
  baseCalculoICMS       Decimal   @db.Decimal(15, 4)
  valorICMS             Decimal   @db.Decimal(15, 4)
  pRedBC                Decimal?  @db.Decimal(5, 2)
  vBCFCP                Decimal?  @db.Decimal(15, 4)
  pFCP                  Decimal?  @db.Decimal(5, 2)
  vFCP                  Decimal?  @db.Decimal(15, 4)
  
  // === ICMS ST ===
  vBCST                 Decimal?  @db.Decimal(15, 4)
  pICMSST               Decimal?  @db.Decimal(5, 2)
  vICMSST               Decimal?  @db.Decimal(15, 4)
  pMVAST                Decimal?  @db.Decimal(5, 2)
  pRedBCST              Decimal?  @db.Decimal(5, 2)
  vBCFCPST              Decimal?  @db.Decimal(15, 4)
  pFCPST                Decimal?  @db.Decimal(5, 2)
  vFCPST                Decimal?  @db.Decimal(15, 4)
  
  // === IPI ===
  cstIPI                String?   @db.Char(2)
  aliquotaIPI           Decimal?  @db.Decimal(5, 2)
  valorIPI              Decimal?  @db.Decimal(15, 4)
  cEnqIPI               String?   @db.VarChar(3)
  
  // === PIS ===
  cstPIS                String    @default("01") @db.Char(2)
  aliquotaPIS           Decimal   @db.Decimal(7, 4)
  valorPIS              Decimal   @db.Decimal(15, 4)
  qBCProdPIS            Decimal?  @db.Decimal(15, 4)
  vAliqProdPIS          Decimal?  @db.Decimal(15, 4)
  vBCSTPIS              Decimal?  @db.Decimal(15, 4)
  pPISST                Decimal?  @db.Decimal(7, 4)
  vPISST                Decimal?  @db.Decimal(15, 4)
  
  // === COFINS ===
  cstCOFINS             String    @default("01") @db.Char(2)
  aliquotaCOFINS        Decimal   @db.Decimal(7, 4)
  valorCOFINS           Decimal   @db.Decimal(15, 4)
  qBCProdCOFINS         Decimal?  @db.Decimal(15, 4)
  vAliqProdCOFINS       Decimal?  @db.Decimal(15, 4)
  vBCSTCOFINS           Decimal?  @db.Decimal(15, 4)
  pCOFINSST             Decimal?  @db.Decimal(7, 4)
  vCOFINSST             Decimal?  @db.Decimal(15, 4)
  
  // === IBS/CBS (Reforma 2026) ===
  cstIBSCBS             String?   @db.Char(2)
  aliquotaIBSUF         Decimal?  @db.Decimal(7, 4)
  valorIBSUF            Decimal?  @db.Decimal(15, 4)
  aliquotaIBSMun        Decimal?  @db.Decimal(7, 4)
  valorIBSMun           Decimal?  @db.Decimal(15, 4)
  aliquotaCBS           Decimal?  @db.Decimal(7, 4)
  valorCBS              Decimal?  @db.Decimal(15, 4)
  
  // === TRIBUTOS ===
  valorTributosAprox    Decimal   @db.Decimal(15, 4) @default(0)
  
  // === INDICADOR ===
  indTot                String    @default("1") @db.Char(1)   // 0=Não compõe total, 1=Compõe
  
  // === INFORMAÇÕES ===
  infAdProd             String?   @db.VarChar(500)
  
  // === RELACIONAMENTOS ===
  nfceId                String
  nfce                  NFCe      @relation(fields: [nfceId], references: [id])
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedA

  @@map("itens_nfce")
  @@index([nfceId])
}

// ============================================
// PAGAMENTO NFC-e
// ============================================

model PagamentoNFCe {
  id                    String    @id @default(cuid())
  nfceId                String
  nfce                  NFCe      @relation(fields: [nfceId], references: [id])
  
  // === DADOS DO PAGAMENTO ===
  indPag                String    @default("0") @db.Char(1)   // 0=Sem pagamento, 1=Com pagamento
  tPag                  String    @db.Char(2)                 // 01-99
  xPag                  String?   @db.VarChar(60)             // Descrição da forma de pagamento
  vPag                  Decimal   @db.Decimal(15, 4)          // Valor do pagamento
  dPag                  DateTime?                             // Data do pagamento
  
  // === INTEGRAÇÃO ===
  tpIntegra             String?   @default("1") @db.Char(1)   // 0=Não integrado, 1=Integrado
  
  // === INSTITUIÇÃO ===
  CNPJPag               String?   @db.Char(14)                // CNPJ do pagador
  UFPag                 String?   @db.Char(2)                 // UF do pagador
  CNPJInstPag           String?   @db.Char(14)                // CNPJ da instituição de pagamento
  
  // === CARTÃO ===
  tBand                 String?   @db.Char(2)                 // Bandeira do cartão (01=Visa, 02=Master, 03=Amex, 04=Elo, 05=Hipercard, 99=Outros)
  cAut                  String?   @db.VarChar(128)            // Código de autorização
  
  // === RECEBEDOR ===
  CNPJReceb             String?   @db.Char(14)                // CNPJ do recebedor
  idTermPag             String?   @db.VarChar(40)             // ID do terminal de pagamento
  
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@map("pagamentos_nfce")
  @@index([nfceId])
}

// ============================================
// HISTÓRICO DE STATUS NFC-e
// ============================================

model HistoricoStatusNFCe {
  id                    String    @id @default(cuid())
  nfceId                String
  nfce                  NFCe      @relation(fields: [nfceId], references: [id])
  statusAnterior        StatusDocumento
  statusNovo            StatusDocumento
  dataHora              DateTime  @default(now())
  usuario               String
  motivo                String?   @db.VarChar(500)
  createdAt             DateTime  @default(now())

  @@map("historico_status_nfce")
  @@index([nfceId])
}

// ============================================
// CTe - CONHECIMENTO DE TRANSPORTE
// ============================================

// ============================================
// ENUMS DO CT-e
// ============================================

enum StatusCTe {
  RASCUNHO
  VALIDADA
  ASSINADA
  PROCESSANDO
  AUTORIZADA
  REJEITADA
  CANCELADA
  DENEGADA
}

enum ModalCTe {
  RODOVIARIO   // 01
  AEREO        // 02
  AQUAVIARIO   // 03
  FERROVIARIO  // 04
  DUTOVIARIO   // 05
  MULTIMODAL   // 06
}

enum TipoServicoCTe {
  NORMAL              // 0
  SUBCONTRATACAO      // 1
  REDESPACHO          // 2
  REDESPACHO_INTERMEDIARIO // 3
  VINCULADO_MULTIMODAL // 4
}

enum TipoCTe {
  NORMAL              // 0
  COMPLEMENTO_VALORES // 1
  SUBSTITUICAO        // 3
}

enum TomadorServicoCTe {
  REMETENTE    // 0
  EXPEDIDOR    // 1
  RECEBEDOR    // 2
  DESTINATARIO // 3
  OUTROS       // 4
}

enum IndicadorIECTe {
  CONTRIBUINTE  // 1
  ISENTO        // 2
  NAO_CONTRIBUINTE // 9
}

enum CSTICMSCTe {
  TRIBUTACAO_NORMAL   // 00
  REDUCAO_BC          // 20
  ISENTA              // 40
  NAO_TRIBUTADA       // 41
  DIFERIDA            // 51
  ST                  // 60
  OUTROS              // 90
}

// ============================================
// MODELO PRINCIPAL CTe
// ============================================

model CTe {
  id                    String      @id @default(cuid())
  
  // === IDENTIFICAÇÃO (ide) ===
  versao                String      @default("4.00") @db.VarChar(4)
  Id                    String?     @unique @db.VarChar(47)
  cUF                   String      @db.Char(2)
  cCT                   String      @db.Char(8)
  CFOP                  String      @db.Char(3)
  natOp                 String      @db.VarChar(60)
  mod                   String      @default("57") @db.Char(2)
  serie                 Int
  nCT                   Int
  dhEmi                 DateTime
  tpImp                 String      @db.Char(1) // 1=Retrato, 2=Paisagem
  tpEmis                String      @default("1") @db.Char(1)
  cDV                   String      @db.Char(1)
  tpAmb                 String      @default("1") @db.Char(1)
  tpCTe                 TipoCTe     @default(NORMAL)
  procEmi               String      @default("0") @db.Char(1)
  verProc               String      @db.VarChar(20)
  indGlobalizado        Boolean?    @default(false)
  cMunEnv               String      @db.Char(7)
  xMunEnv               String      @db.VarChar(60)
  UFEnv                 String      @db.Char(2)
  modal                 ModalCTe
  tpServ                TipoServicoCTe
  cMunIni               String      @db.Char(7)
  xMunIni               String      @db.VarChar(60)
  UFIni                 String      @db.Char(2)
  cMunFim               String      @db.Char(7)
  xMunFim               String      @db.VarChar(60)
  UFFim                 String      @db.Char(2)
  retira                String      @db.Char(1) // 0=Sim, 1=Não
  xDetRetira            String?     @db.VarChar(160)
  indIEToma             IndicadorIECTe @default(NAO_CONTRIBUINTE)
  
  // === TOMADOR (toma3 ou toma4) ===
  toma                  TomadorServicoCTe
  
  // === DADOS DO TOMADOR (quando toma = 4) ===
  tomadorCNPJ           String?     @db.Char(14)
  tomadorCPF            String?     @db.Char(11)
  tomadorIE             String?     @db.VarChar(14)
  tomadorxNome          String?     @db.VarChar(60)
  tomadorxFant          String?     @db.VarChar(60)
  tomadorFone           String?     @db.VarChar(14)
  tomadorEmail          String?     @db.VarChar(60)
  
  // === ENDEREÇO DO TOMADOR ===
  tomadorxLgr           String?     @db.VarChar(255)
  tomadorNro            String?     @db.VarChar(60)
  tomadorxCpl           String?     @db.VarChar(60)
  tomadorxBairro        String?     @db.VarChar(60)
  tomadorcMun           String?     @db.Char(7)
  tomadorxMun           String?     @db.VarChar(60)
  tomadorCEP            String?     @db.Char(8)
  tomadorUF             String?     @db.Char(2)
  tomadorcPais          String?     @db.Char(4)
  tomadorxPais          String?     @db.VarChar(60)
  
  // === CONTINGÊNCIA ===
  dhCont                DateTime?
  xJust                 String?     @db.VarChar(256)
  
  // === COMPRAS GOVERNAMENTAIS ===
  tpEnteGov             String?     @db.Char(1)
  pRedutor              String?     @db.VarChar(5)
  tpOperGov             String?     @db.Char(1)
  refDFeAnt             String?     @db.VarChar(44)
  
  // === DADOS COMPLEMENTARES (compl) ===
  xCaracAd              String?     @db.VarChar(15)
  xCaracSer             String?     @db.VarChar(30)
  xEmi                  String?     @db.VarChar(20)
  
  // === FLUXO (fluxo) ===
  xOrig                 String?     @db.VarChar(60)
  xDest                 String?     @db.VarChar(60)
  xRota                 String?     @db.VarChar(10)
  
  // === PREVISÃO DE ENTREGA (Entrega) ===
  tpPer                 String?     @db.Char(1) // 0=Sem data, 1=Na data, 2=Até a data, 3=A partir da data, 4=No período
  dProg                 DateTime?
  dIni                  DateTime?
  dFim                  DateTime?
  tpHor                 String?     @db.Char(1) // 0=Sem hora, 1=No horário, 2=Até o horário, 3=A partir do horário, 4=No intervalo
  hProg                 String?     @db.Char(8) // HH:MM:SS
  hIni                  String?     @db.Char(8) // HH:MM:SS
  hFim                  String?     @db.Char(8) // HH:MM:SS
  
  origCalc              String?     @db.VarChar(40)
  destCalc              String?     @db.VarChar(40)
  xObs                  String?     @db.VarChar(2000)
  
  // === VALORES DA PRESTAÇÃO (vPrest) ===
  vTPrest               Decimal     @db.Decimal(15, 2)
  vRec                  Decimal     @db.Decimal(15, 2)
  
  // === IMPOSTOS (imp) ===
  // ICMS00 - Tributação Normal
  CST00                 String?     @db.Char(2)
  vBC00                 Decimal?    @db.Decimal(15, 2)
  pICMS00               Decimal?    @db.Decimal(5, 2)
  vICMS00               Decimal?    @db.Decimal(15, 2)
  
  // ICMS20 - Redução BC
  CST20                 String?     @db.Char(2)
  pRedBC20              Decimal?    @db.Decimal(5, 2)
  vBC20                 Decimal?    @db.Decimal(15, 2)
  pICMS20               Decimal?    @db.Decimal(5, 2)
  vICMS20               Decimal?    @db.Decimal(15, 2)
  
  // ICMS45 - Isento/Não Tributado/Diferido
  CST45                 String?     @db.Char(2)
  vICMSDeson45          Decimal?    @db.Decimal(15, 2)
  cBenef45              String?     @db.VarChar(10)
  
  // ICMS60 - Substituição Tributária
  CST60                 String?     @db.Char(2)
  vBCSTRet              Decimal?    @db.Decimal(15, 2)
  vICMSSTRet            Decimal?    @db.Decimal(15, 2)
  pICMSSTRet            Decimal?    @db.Decimal(5, 2)
  vCred                 Decimal?    @db.Decimal(15, 2)
  
  // ICMS90 - Outros
  CST90                 String?     @db.Char(2)
  pRedBC90              Decimal?    @db.Decimal(5, 2)
  vBC90                 Decimal?    @db.Decimal(15, 2)
  pICMS90               Decimal?    @db.Decimal(5, 2)
  vICMS90               Decimal?    @db.Decimal(15, 2)
  vCred90               Decimal?    @db.Decimal(15, 2)
  
  // ICMSOutraUF
  CSTOutraUF            String?     @db.Char(2)
  pRedBCOutraUF         Decimal?    @db.Decimal(5, 2)
  vBCOutraUF            Decimal?    @db.Decimal(15, 2)
  pICMSOutraUF          Decimal?    @db.Decimal(5, 2)
  vICMSOutraUF          Decimal?    @db.Decimal(15, 2)
  
  // ICMSSN - Simples Nacional
  CSTSN                 String?     @db.Char(2)
  indSN                 String?     @db.Char(1) // 1=Sim
  
  // ICMSUFFim - Partilha
  vBCUFFim              Decimal?    @db.Decimal(15, 2)
  pFCPUFFim             Decimal?    @db.Decimal(5, 2)
  pICMSUFFim            Decimal?    @db.Decimal(5, 2)
  pICMSInter            Decimal?    @db.Decimal(5, 2)
  vFCPUFFim             Decimal?    @db.Decimal(15, 2)
  vICMSUFFim            Decimal?    @db.Decimal(15, 2)
  vICMSUFIni            Decimal?    @db.Decimal(15, 2)
  
  // IBS/CBS
  CSTIBSCBS             String?     @db.Char(3)
  cClassTrib            String?     @db.Char(6)
  indDoacao             String?     @db.Char(1)
  vBCIBS                Decimal?    @db.Decimal(15, 2)
  pIBSUF                Decimal?    @db.Decimal(5, 4)
  pDifIBSUF             Decimal?    @db.Decimal(5, 4)
  vDifIBSUF             Decimal?    @db.Decimal(15, 2)
  vDevTribIBSUF         Decimal?    @db.Decimal(15, 2)
  pRedAliqIBSUF         Decimal?    @db.Decimal(5, 4)
  pAliqEfetIBSUF        Decimal?    @db.Decimal(5, 4)
  vIBSUF                Decimal?    @db.Decimal(15, 2)
  
  pIBSMun               Decimal?    @db.Decimal(5, 4)
  pDifIBSMun            Decimal?    @db.Decimal(5, 4)
  vDifIBSMun            Decimal?    @db.Decimal(15, 2)
  vDevTribIBSMun        Decimal?    @db.Decimal(15, 2)
  pRedAliqIBSMun        Decimal?    @db.Decimal(5, 4)
  pAliqEfetIBSMun       Decimal?    @db.Decimal(5, 4)
  vIBSMun               Decimal?    @db.Decimal(15, 2)
  vIBS                  Decimal?    @db.Decimal(15, 2)
  
  pCBS                  Decimal?    @db.Decimal(5, 4)
  pDifCBS               Decimal?    @db.Decimal(5, 4)
  vDifCBS               Decimal?    @db.Decimal(15, 2)
  vDevTribCBS           Decimal?    @db.Decimal(15, 2)
  pRedAliqCBS           Decimal?    @db.Decimal(5, 4)
  pAliqEfetCBS          Decimal?    @db.Decimal(5, 4)
  vCBS                  Decimal?    @db.Decimal(15, 2)
  
  // Tributação Regular
  CSTReg                String?     @db.Char(3)
  cClassTribReg         String?     @db.Char(6)
  pAliqEfetRegIBSUF     Decimal?    @db.Decimal(5, 4)
  vTribRegIBSUF         Decimal?    @db.Decimal(15, 2)
  pAliqEfetRegIBSMun    Decimal?    @db.Decimal(5, 4)
  vTribRegIBSMun        Decimal?    @db.Decimal(15, 2)
  pAliqEfetRegCBS       Decimal?    @db.Decimal(5, 4)
  vTribRegCBS           Decimal?    @db.Decimal(15, 2)
  
  // Estorno de Crédito
  vIBSEstCred           Decimal?    @db.Decimal(15, 2)
  vCBSEstCred           Decimal?    @db.Decimal(15, 2)
  
  // Informações Adicionais Fisco
  infAdFisco            String?     @db.VarChar(2000)
  
  // === TOTAL DO DOCUMENTO ===
  vTotDFe               Decimal?    @db.Decimal(15, 2)
  
  // === INFORMAÇÕES DA CARGA (infCarga) ===
  vCarga                Decimal?    @db.Decimal(15, 2)
  proPred               String      @db.VarChar(60)
  xOutCat               String?     @db.VarChar(30)
  vCargaAverb           Decimal?    @db.Decimal(15, 2)
  
  // === VEÍCULOS NOVOS ===
  veicChassi            String?     @db.VarChar(17)
  veicCor               String?     @db.VarChar(4)
  veicxCor              String?     @db.VarChar(40)
  veiccMod              String?     @db.VarChar(6)
  veicvUnit             Decimal?    @db.Decimal(15, 2)
  veicvFrete            Decimal?    @db.Decimal(15, 2)
  
  // === COBRANÇA (cobr) ===
  nFat                  String?     @db.VarChar(60)
  vOrig                 Decimal?    @db.Decimal(15, 2)
  vDesc                 Decimal?    @db.Decimal(15, 2)
  vLiq                  Decimal?    @db.Decimal(15, 2)
  
  // === CT-e DE SUBSTITUIÇÃO ===
  chCteSub              String?     @db.Char(44)
  indAlteraToma         String?     @db.Char(1)
  
  // === CT-e GLOBALIZADO ===
  xObsGlobalizado       String?     @db.VarChar(256)
  
  // === STATUS ===
  status                StatusCTe   @default(RASCUNHO)
  
  // === PROTOCOLOS ===
  protocoloAutorizacao  String?     @db.Char(17)
  dataHoraAutorizacao   DateTime?
  motivoCancelamento    String?
  dataHoraCancelamento  DateTime?
  motivoRejeicao        String?     @db.VarChar(500)
  dataHoraRejeicao      DateTime?
  motivoEncerramento    String?     @db.VarChar(255)
  dataHoraEncerramento  DateTime?
  
  // === XMLs ===
  xmlAssinado           String      @db.Text
  xmlRetorno            String?     @db.Text
  xmlModal              String?     @db.Text // XML específico do modal
  
  // === CONTROLE ===
  enviadoEm             DateTime?
  enviadoPor            String?
  ipEnvio               String?     @db.VarChar(45)
  reciboLote            String?     @db.VarChar(15)
  chaveAcesso           String?     @unique @db.Char(44)
  
  // === RELACIONAMENTOS ===
  empresaId             String
  empresa               Empresa     @relation(fields: [empresaId], references: [id])
  
  emitenteId            String
  emitente              Empresa     @relation("CTeEmitente", fields: [emitenteId], references: [id])
  
  remetenteId           String?
  remetente             Cliente?    @relation("CTeRemetente", fields: [remetenteId], references: [id])
  
  destinatarioId        String?
  destinatario          Cliente?    @relation("CTeDestinatario", fields: [destinatarioId], references: [id])
  
  expedidorId           String?
  expedidor             Cliente?    @relation("CTeExpedidor", fields: [expedidorId], references: [id])
  
  recebedorId           String?
  recebedor             Cliente?    @relation("CTeRecebedor", fields: [recebedorId], references: [id])
  
  transportadoraId      String?
  transportadora        Transportadora? @relation(fields: [transportadoraId], references: [id])
  
  // === SUB-ESTRUTURAS ===
  componentes           ComponenteCTe[]
  quantidades           QuantidadeCTe[]
  documentos            DocumentoCTe[]
  duplicatas            DuplicataCTe[]
  observacoes           ObsContCTe[]
  observacoesFisco      ObsFiscoCTe[]
  autorizadosDownload   AutXMLCTe[]
  historicoStatus       HistoricoStatusCTe[]
  complementos          CTeComplemento[]
  substitutos           CTeSubstituto[]
  globalizados          CTeGlobalizado[]
  servicosVinculados    CTeServicoVinculado[]
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("ctes")
  @@index([empresaId])
  @@index([chaveAcesso])
  @@index([status])
  @@index([modal])
  @@index([tpCTe])
  @@index([emitenteId])
  @@index([remetenteId])
  @@index([destinatarioId])
}

// ============================================
// COMPONENTES DO VALOR DA PRESTAÇÃO
// ============================================

model ComponenteCTe {
  id                    String      @id @default(cuid())
  cteId                 String
  cte                   CTe         @relation(fields: [cteId], references: [id])
  xNome                 String      @db.VarChar(15)
  vComp                 Decimal     @db.Decimal(15, 2)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_componentes")
  @@index([cteId])
}

// ============================================
// QUANTIDADES DA CARGA
// ============================================

model QuantidadeCTe {
  id                    String      @id @default(cuid())
  cteId                 String
  cte                   CTe         @relation(fields: [cteId], references: [id])
  cUnid                 String      @db.Char(2) // 00=M3, 01=KG, 02=TON, 03=UNIDADE, 04=LITROS, 05=MMBTU
  tpMed                 String      @db.VarChar(20)
  qCarga                Decimal     @db.Decimal(11, 4)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_quantidades")
  @@index([cteId])
}

// ============================================
// DOCUMENTOS TRANSPORTADOS
// ============================================

model DocumentoCTe {
  id                    String      @id @default(cuid())
  cteId                 String
  cte                   CTe         @relation(fields: [cteId], references: [id])
  
  // Tipo de documento: NF, NFe, Outros, DCe
  tipo                  String      @db.VarChar(10) // NF, NFe, OUTROS, DCe
  
  // Campos comuns
  chave                 String?     @db.Char(44)
  serie                 String?     @db.VarChar(3)
  nDoc                  String?     @db.VarChar(20)
  dEmi                  DateTime?
  dPrev                 DateTime?
  nRoma                 String?     @db.VarChar(20)
  nPed                  String?     @db.VarChar(20)
  mod                   String?     @db.Char(2)
  
  // Valores NF
  vBC                   Decimal?    @db.Decimal(15, 2)
  vICMS                 Decimal?    @db.Decimal(15, 2)
  vBCST                 Decimal?    @db.Decimal(15, 2)
  vST                   Decimal?    @db.Decimal(15, 2)
  vProd                 Decimal?    @db.Decimal(15, 2)
  vNF                   Decimal?    @db.Decimal(15, 2)
  nCFOP                 String?     @db.Char(3)
  nPeso                 Decimal?    @db.Decimal(12, 3)
  PIN                   String?     @db.VarChar(9)
  
  // Outros documentos
  tpDoc                 String?     @db.Char(2)
  descOutros            String?     @db.VarChar(100)
  vDocFisc              Decimal?    @db.Decimal(15, 2)
  
  // === UNIDADES DE CARGA E TRANSPORTE ===
  unidadesCarga         DocumentoUnidadeCarga[]
  unidadesTransporte    DocumentoUnidadeTransporte[]
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_documentos")
  @@index([cteId])
  @@index([chave])
}

// ============================================
// UNIDADE DE CARGA (Container/ULD/Pallet)
// ============================================

model DocumentoUnidadeCarga {
  id                    String      @id @default(cuid())
  documentoId           String
  documento             DocumentoCTe @relation(fields: [documentoId], references: [id])
  tpUnidCarga           String      @db.Char(1) // 1=Container, 2=ULD, 3=Pallet, 4=Outros
  idUnidCarga           String      @db.VarChar(20)
  qtdRat                Decimal?    @db.Decimal(3, 3)
  
  lacres                UnidadeCargaLacre[]
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_unidades_carga")
  @@index([documentoId])
}

model UnidadeCargaLacre {
  id                    String      @id @default(cuid())
  unidadeCargaId        String
  unidadeCarga          DocumentoUnidadeCarga @relation(fields: [unidadeCargaId], references: [id])
  nLacre                String      @db.VarChar(20)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_unidade_carga_lacres")
  @@index([unidadeCargaId])
}

// ============================================
// UNIDADE DE TRANSPORTE (Carreta/Reboque/Vagão)
// ============================================

model DocumentoUnidadeTransporte {
  id                    String      @id @default(cuid())
  documentoId           String
  documento             DocumentoCTe @relation(fields: [documentoId], references: [id])
  tpUnidTransp          String      @db.Char(1) // 1=Tração, 2=Reboque, 3=Navio, 4=Balsa, 5=Aeronave, 6=Vagão, 7=Outros
  idUnidTransp          String      @db.VarChar(20)
  qtdRat                Decimal?    @db.Decimal(3, 3)
  
  lacres                UnidadeTransporteLacre[]
  unidadesCarga         DocumentoUnidadeCarga[]
  
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_unidades_transporte")
  @@index([documentoId])
}

model UnidadeTransporteLacre {
  id                    String      @id @default(cuid())
  unidadeTransporteId   String
  unidadeTransporte     DocumentoUnidadeTransporte @relation(fields: [unidadeTransporteId], references: [id])
  nLacre                String      @db.VarChar(20)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_unidade_transporte_lacres")
  @@index([unidadeTransporteId])
}

// ============================================
// DUPLICATAS
// ============================================

model DuplicataCTe {
  id                    String      @id @default(cuid())
  cteId                 String
  cte                   CTe         @relation(fields: [cteId], references: [id])
  nDup                  String      @db.VarChar(60)
  dVenc                 DateTime
  vDup                  Decimal     @db.Decimal(15, 2)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_duplicatas")
  @@index([cteId])
}

// ============================================
// OBSERVAÇÕES
// ============================================

model ObsContCTe {
  id                    String      @id @default(cuid())
  cteId                 String
  cte                   CTe         @relation(fields: [cteId], references: [id])
  xCampo                String      @db.VarChar(20)
  xTexto                String      @db.VarChar(160)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_obs_cont")
  @@index([cteId])
}

model ObsFiscoCTe {
  id                    String      @id @default(cuid())
  cteId                 String
  cte                   CTe         @relation(fields: [cteId], references: [id])
  xCampo                String      @db.VarChar(20)
  xTexto                String      @db.VarChar(60)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_obs_fisco")
  @@index([cteId])
}

// ============================================
// AUTORIZADOS PARA DOWNLOAD
// ============================================

model AutXMLCTe {
  id                    String      @id @default(cuid())
  cteId                 String
  cte                   CTe         @relation(fields: [cteId], references: [id])
  CNPJ                  String?     @db.Char(14)
  CPF                   String?     @db.Char(11)
  createdAt             DateTime    @default(now())
  updatedAt             DateTime    @updatedAt

  @@map("cte_aut_xml")
  @@index([cteId])
}

// ============================================
// HISTÓRICO DE STATUS
// ============================================

model HistoricoStatusCTe {
  id                    String      @id @default(cuid())
  cteId                 String
  cte                   CTe         @relation(fields: [cteId], references: [id])
  statusAnterior        StatusCTe
  statusNovo            StatusCTe
  dataHora              DateTime    @default(now())
  usuario               String
  motivo                String?     @db.VarChar(500)
  createdAt             DateTime    @default(now())

  @@map("cte_historico_status")
  @@index([cteId])
}

// ============================================
// CT-e DE COMPLEMENTO
// ============================================

model CTeComplemento {
  id                    String      @id @default(cuid())
